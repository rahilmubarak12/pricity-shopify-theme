{% comment %}
  Shopify search-results template for the Apricity theme.
  Upload this file to: templates/search.liquid
{% endcomment %}

{%- assign is_arabic = request.locale.iso_code == 'ar' -%}

{% paginate search.results by 24 %}
  <main class="min-h-screen bg-[#faf9f7] px-6 py-20 md:px-16 md:py-24" {% if is_arabic %}dir="rtl"{% endif %}>
    <div class="mx-auto max-w-7xl">
      <header class="mb-12 border-b border-zinc-200 pb-8 md:mb-16">
        <span class="font-mono-street text-[11px] uppercase tracking-[0.25em] text-zinc-400">
          {% if is_arabic %}اكتشف{% else %}Discover{% endif %}
        </span>

        <h1 class="mt-2 font-heading text-3xl font-extrabold uppercase text-[#1a1a1a] md:text-5xl">
          {% if search.performed %}
            {% if is_arabic %}نتائج البحث{% else %}Search Results{% endif %}
          {% else %}
            {% if is_arabic %}ابحث في المتجر{% else %}Search the Store{% endif %}
          {% endif %}
        </h1>

        <form action="{{ routes.search_url }}" method="get" role="search" class="mt-8 flex max-w-2xl border-b border-[#1a1a1a]">
          <input type="hidden" name="options[prefix]" value="last">
          <input class="min-w-0 flex-1 bg-transparent py-3 text-base text-[#1a1a1a] outline-none placeholder:text-zinc-400" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{% if is_arabic %}ابحث عن منتج{% else %}Search for a product{% endif %}" autocomplete="off">
          <button type="submit" class="px-3 text-[#1a1a1a] transition-opacity hover:opacity-60" aria-label="{% if is_arabic %}بحث{% else %}Search{% endif %}">
            <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </button>
        </form>

        {% if search.performed %}
          <p class="mt-5 font-mono-street text-[11px] uppercase tracking-wider text-zinc-400">
            {% if is_arabic %}
              {{ search.results_count }} نتيجة لـ «{{ search.terms | escape }}»
            {% else %}
              {{ search.results_count }} results for “{{ search.terms | escape }}”
            {% endif %}
          </p>
        {% endif %}
      </header>

      {% if search.performed %}
        {% assign has_products = false %}
        <div class="grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-6 sm:gap-y-12 lg:grid-cols-3 xl:grid-cols-4">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% assign has_products = true %}
              {% render 'product-card', product: item %}
            {% endif %}
          {% endfor %}
        </div>

        {% unless has_products %}
          <div class="flex min-h-72 flex-col items-center justify-center border-y border-zinc-200 py-16 text-center">
            <p class="font-mono-street text-xs uppercase tracking-[0.22em] text-zinc-400">
              {% if is_arabic %}لم نعثر على منتجات مطابقة{% else %}No matching products found{% endif %}
            </p>
            <p class="mt-3 text-sm font-light text-zinc-500">
              {% if is_arabic %}جرّب كلمة بحث أخرى.{% else %}Try a different search term.{% endif %}
            </p>
          </div>
        {% endunless %}
      {% else %}
        <div class="flex min-h-72 items-center justify-center border-y border-zinc-200 py-16 text-center">
          <p class="font-mono-street text-xs uppercase tracking-[0.22em] text-zinc-400">
            {% if is_arabic %}اكتب ما تبحث عنه بالأعلى{% else %}Enter a search term above{% endif %}
          </p>
        </div>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="mt-16 flex items-center justify-center gap-2 font-mono-street text-[11px] uppercase tracking-widest" role="navigation" aria-label="Pagination">
          {% if paginate.previous %}
            <a class="px-3 py-2 text-zinc-400 transition-colors hover:text-[#1a1a1a]" href="{{ paginate.previous.url }}">{% if is_arabic %}السابق{% else %}Previous{% endif %}</a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a class="px-3 py-2 text-zinc-400 transition-colors hover:text-[#1a1a1a]" href="{{ part.url }}">{{ part.title }}</a>
            {% else %}
              <span class="px-3 py-2 {% if part.title == paginate.current_page %}bg-[#1a1a1a] text-white{% else %}text-zinc-400{% endif %}">{{ part.title }}</span>
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a class="px-3 py-2 text-zinc-400 transition-colors hover:text-[#1a1a1a]" href="{{ paginate.next.url }}">{% if is_arabic %}التالي{% else %}Next{% endif %}</a>
          {% endif %}
        </nav>
      {% endif %}
    </div>
  </main>
{% endpaginate %}
