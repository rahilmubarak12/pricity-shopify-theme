{% comment %}
  Shopify search-results template for the Apricity theme.
  Upload this file to: templates/search.liquid
{% endcomment %}

{%- assign is_arabic = false -%}
{%- if request.locale.iso_code == 'ar' -%}
  {%- assign is_arabic = true -%}
{%- endif -%}

<style>
  .apricity-search-page {
    min-height: 100vh;
    padding: 15rem 1.5rem 6rem;
    background: #faf9f7;
    color: #1a1a1a;
  }

  .apricity-search-wrap {
    max-width: 80rem;
    margin: 0 auto;
  }

  .apricity-search-heading {
    max-width: 42rem;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .apricity-search-eyebrow,
  .apricity-search-count {
    margin: 0;
    font-family: "Courier New", monospace;
    font-size: 0.6875rem;
    line-height: 1.7;
    letter-spacing: 0.16em;
    color: #9a9a9a;
  }

  .apricity-search-title {
    margin: 0.65rem 0 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .apricity-search-count {
    margin-top: 1.25rem;
  }

  .apricity-search-empty {
    display: flex;
    min-height: 14rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
  }

  .apricity-search-empty__title {
    margin: 0;
    font-family: "Courier New", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: #8a8a8a;
  }

  .apricity-search-empty__text {
    margin: 0;
    color: #6b6b6b;
    font-size: 0.95rem;
  }

  @media (max-width: 749px) {
    .apricity-search-page {
      padding-top: 11rem;
    }

    .apricity-search-heading {
      margin-bottom: 2.5rem;
    }
  }
</style>

{% paginate search.results by 24 %}
  <main class="apricity-search-page" {% if is_arabic %}dir="rtl"{% endif %}>
    <div class="apricity-search-wrap">
      <header class="apricity-search-heading">
        <span class="apricity-search-eyebrow">
          {% if is_arabic %}اكتشف{% else %}Discover{% endif %}
        </span>

        {% unless search.performed %}
          <h1 class="apricity-search-title">
            {% if is_arabic %}ابحث في المتجر{% else %}Search the Store{% endif %}
          </h1>
        {% endunless %}

        {% if search.performed %}
          <h1 class="apricity-search-title">
            {% if is_arabic %}نتائج البحث{% else %}Search Results{% endif %}
          </h1>

          <p class="apricity-search-count">
            {% if is_arabic %}
              {{ search.results_count }} نتيجة لـ «{{ search.terms | escape }}»
            {% else %}
              {{ search.results_count }} results for “{{ search.terms | escape }}”
            {% endif %}
          </p>
        {% endif %}
      </header>

      {% if search.performed %}
        {% assign has_products = false %}

        <div class="grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-6 sm:gap-y-12 lg:grid-cols-3 xl:grid-cols-4">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% assign has_products = true %}
              {% render 'product-card', product: item %}
            {% endif %}
          {% endfor %}
        </div>

        {% unless has_products %}
          <div class="apricity-search-empty">
            <p class="apricity-search-empty__title">
              {% if is_arabic %}لم نعثر على منتجات مطابقة{% else %}No matching products found{% endif %}
            </p>

            <p class="apricity-search-empty__text">
              {% if is_arabic %}جرّب كلمة بحث أخرى.{% else %}Try a different search term.{% endif %}
            </p>
          </div>
        {% endunless %}
      {% else %}
        <div class="apricity-search-empty">
          <p class="apricity-search-empty__title">
            {% if is_arabic %}اكتب ما تبحث عنه في خانة البحث بالأعلى{% else %}Enter a search term above{% endif %}
          </p>
        </div>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav
          class="mt-16 flex items-center justify-center gap-2 font-mono-street text-[11px] uppercase tracking-widest"
          role="navigation"
          aria-label="{% if is_arabic %}ترقيم الصفحات{% else %}Pagination{% endif %}"
        >
          {% if paginate.previous %}
            <a class="px-3 py-2 text-zinc-400 transition-colors hover:text-[#1a1a1a]" href="{{ paginate.previous.url }}">
              {% if is_arabic %}السابق{% else %}Previous{% endif %}
            </a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a class="px-3 py-2 text-zinc-400 transition-colors hover:text-[#1a1a1a]" href="{{ part.url }}">
                {{ part.title }}
              </a>
            {% else %}
              <span class="px-3 py-2 {% if part.title == paginate.current_page %}bg-[#1a1a1a] text-white{% else %}text-zinc-400{% endif %}">
                {{ part.title }}
              </span>
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a class="px-3 py-2 text-zinc-400 transition-colors hover:text-[#1a1a1a]" href="{{ paginate.next.url }}">
              {% if is_arabic %}التالي{% else %}Next{% endif %}
            </a>
          {% endif %}
        </nav>
      {% endif %}
    </div>
  </main>
{% endpaginate %}


