<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    {%- if settings.bing_site_verification != blank -%}
      <meta name="msvalidate.01" content="{{ settings.bing_site_verification }}">
    {%- endif -%}
    {%- if settings.google_site_verification != blank -%}
      <meta name="google-site-verification" content="{{ settings.google_site_verification }}">
    {%- endif -%}
    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://shop.app" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/x-icon" href="{{ 'favicon.ico' | asset_url }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags -%} &ndash; tagged "{{ current_tags | join: ', ' }}"{%- endif -%}
      {%- if current_page != 1 -%} &ndash; Page {{ current_page }}{%- endif -%}
      {%- unless page_title contains shop.name -%} &ndash; {{ shop.name }}{%- endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- if template.name == 'collection' -%}
      <script>
        window.location.href = "{{ routes.root_url }}?filter={{ collection.handle }}";
      </script>
    {%- endif -%}

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>

    <style>
      :root {
        {%- if settings.color_primary != blank -%}
          --color-primary: {{ settings.color_primary | color_extract: 'red' }} {{ settings.color_primary | color_extract: 'green' }} {{ settings.color_primary | color_extract: 'blue' }};
        {%- endif -%}
        {%- if settings.color_contrast != blank -%}
          --color-contrast: {{ settings.color_contrast | color_extract: 'red' }} {{ settings.color_contrast | color_extract: 'green' }} {{ settings.color_contrast | color_extract: 'blue' }};
        {%- endif -%}
        {%- if settings.color_accent != blank -%}
          --color-accent: {{ settings.color_accent | color_extract: 'red' }} {{ settings.color_accent | color_extract: 'green' }} {{ settings.color_accent | color_extract: 'blue' }};
        {%- endif -%}
        {%- if settings.color_background != blank -%}
          --color-bg-base: {{ settings.color_background }};
        {%- endif -%}
      }
      
      body {
        {%- if settings.color_background != blank -%}
          background-color: {{ settings.color_background }} !important;
        {%- endif -%}
      }
    </style>
    {%- comment -%} Effeect (Nov 2026): Microsoft Clarity, project z5cjtrt6td. The Clarity app embed rendered nothing (project never linked), so the tag lives here and the app embed is switched off to avoid double tracking. {%- endcomment -%}
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "z5cjtrt6td");
    </script>

    {%- comment -%} Effeect CRO fixes (Nov 2026): smaller logo on phones (the search icon covered it); hide the 'Want 15% off?' teaser on set pages (APY-15 excludes the sets) and on the cart page (it covered the Checkout button). {%- endcomment -%}
    <style>
      @media (max-width: 639px) {
        header a > img + .apricity-wordmark { font-size: 18px !important; letter-spacing: .16em !important; }
        header a:has(> .apricity-wordmark) { gap: 8px !important; }
        header a:has(> .apricity-wordmark) > img { height: 32px !important; width: 32px !important; }
      }
    </style>
    {%- liquid
      assign apy_hide_teaser = false
      if template.name == 'cart'
        assign apy_hide_teaser = true
      elsif template.name == 'product' and product.type == 'Sets'
        assign apy_hide_teaser = true
      endif
    -%}
    {%- if apy_hide_teaser -%}
      <style>.discount-sticky-bar, .discount-modal-overlay { display: none !important; }</style>
    {%- endif -%}
  </head>

  <body>
    <a class="skip-to-content-link sr-only" href="#MainContent">
      Skip to content
    </a>

    {% comment %} Header section will be built in Phase 2 {% endcomment %}
    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% comment %} Footer section will be built in Phase 2 {% endcomment %}
    {% section 'footer' %}

    {% comment %} Custom overlays/drawers (Phase 3/4) {% endcomment %}
    {% section 'cart-drawer' %}
    {% section 'product-modal' %}
    {% section 'discount-popup' %}


  </body>
</html>
