{% comment %}
  Header Section
  Frosted glass scrolling navbar, mobile navigation drawer, and compact separated round Flag Language Switchers (SA & UK).
{% endcomment %}

<style>
  .nav-link-hover {
    position: relative;
    text-decoration: none !important;
    display: inline-block;
    padding-bottom: 0 !important;
  }
  .nav-link-hover::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1.5px;
    background: currentColor;
    transition: width 0.25s ease;
    max-width: 100%;
  }
  .nav-link-hover:hover::after {
    width: 100%;
    color: inherit;
  }
  .nav-link-hover:hover {
    color: inherit;
    opacity: 1 !important;
  }
  /* On hero (unscrolled) hover = white */
  .main-navbar.text-white .nav-link-hover:hover {
    color: #ffffff !important;
  }
  /* On scrolled navbar hover = dark */
  .main-navbar.text-\[\#1a1a1a\] .nav-link-hover:hover {
    color: #1a1a1a !important;
  }
</style>
<header class="fixed top-0 left-0 right-0 z-40">
  <!-- Announcement Bar -->
  {%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
    <div class="bg-black/95 backdrop-blur-sm text-white/70 text-[10px] sm:text-[11px] font-mono-street tracking-[0.2em] py-2.5 px-4 text-center uppercase overflow-hidden">
      <span class="inline-block sm:inline animate-marquee sm:animate-none whitespace-nowrap">
        {{ section.settings.announcement_text }}
      </span>
    </div>
  {%- endif -%}

  <!-- Main Navbar -->
  <nav class="main-navbar transition-all duration-300 px-4 sm:px-6 lg:px-16 py-4 lg:py-5 bg-gradient-to-b from-black/50 to-transparent text-white">
    <div class="grid grid-cols-3 items-center">
      
      <!-- LEFT: Hamburger (Mobile) / Links (Desktop) -->
      <div class="flex items-center justify-start">
        <button class="mobile-menu-trigger lg:hidden transition-colors p-1 text-current" aria-label="Open Menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
        </button>

        <div class="hidden lg:flex items-center gap-8 text-[17px] font-mono-street tracking-[0.06em] capitalize font-medium">
          {%- assign main_menu_links = linklists[section.settings.menu].links -%}
          {%- if main_menu_links == blank or main_menu_links.size == 0 -%}
            <a href="{{ shop.url }}/?filter=men" class="relative transition-colors nav-link-hover text-white/70 hover:text-white">Men</a>
            <a href="{{ shop.url }}/?filter=women" class="relative transition-colors nav-link-hover text-white/70 hover:text-white">Women</a>
            <a href="{{ shop.url }}/?filter=new-drops" class="relative transition-colors nav-link-hover text-white/70 hover:text-white">New Drops</a>
            {%- if section.settings.show_the_rule -%}
              <a href="{{ section.settings.the_rule_link | default: '/pages/our-story' }}" class="relative transition-colors nav-link-hover text-white/70 hover:text-white no-underline normal-case the-rule-trigger">
                {{ section.settings.the_rule_text | default: 'The Rule' }}
              </a>
            {%- endif -%}
            <a href="{{ shop.url }}/?filter=sale" class="relative transition-colors nav-link-hover text-white/70 hover:text-white">Sale</a>
          {%- else -%}
            {%- for link in main_menu_links -%}
              <a href="{{ link.url }}" class="relative transition-colors nav-link-hover text-white/70 hover:text-white {% if link.active %}font-bold border-b border-current text-white{% endif %}">
                {{ link.title }}
              </a>
            {%- endfor -%}
            {%- if section.settings.show_the_rule -%}
              <a href="{{ section.settings.the_rule_link | default: '/pages/our-story' }}" class="relative transition-colors nav-link-hover text-white/70 hover:text-white no-underline normal-case the-rule-trigger">
                {{ section.settings.the_rule_text | default: 'The Rule' }}
              </a>
            {%- endif -%}
          {%- endif -%}

          <!-- Contact Dropdown -->
          {%- if section.settings.show_contact != false -%}
            <div class="relative group flex items-center contact-dropdown">
              <button class="relative transition-colors nav-link-hover text-white/70 hover:text-white outline-none cursor-pointer capitalize font-mono-street text-[17px] font-medium tracking-[0.06em]">
                {{ section.settings.contact_trigger_label | default: 'Contact' }}
              </button>
              <div class="absolute left-0 top-full mt-2 w-72 bg-black border border-zinc-800 text-white p-5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 shadow-[0_10px_30px_rgba(0,0,0,0.8)] z-50 rounded-sm">
                <div class="flex flex-col space-y-4 text-[10px] tracking-[0.15em] font-mono-street uppercase text-left">
                  <span class="text-zinc-500 border-b border-zinc-800 pb-1.5 block font-bold text-[11px] tracking-widest">{{ section.settings.contact_details_label | default: 'Contact Details' }}</span>
                  {%- if section.settings.whatsapp_number != blank -%}
                    <div class="space-y-1">
                      <span class="text-zinc-600 block text-[8px] font-bold">{{ section.settings.whatsapp_label | default: 'WhatsApp Support' }}</span>
                      <a href="{{ section.settings.whatsapp_url | default: 'https://wa.me/966536470644' }}" target="_blank" rel="noopener noreferrer" class="text-white hover:text-zinc-300 transition-colors block text-[11px] font-semibold">
                        {{ section.settings.whatsapp_number }}
                      </a>
                    </div>
                  {%- endif -%}
                  {%- if section.settings.email_address != blank -%}
                    <div class="space-y-1">
                      <span class="text-zinc-600 block text-[8px] font-bold">{{ section.settings.email_label | default: 'Email Inquiry' }}</span>
                      <a href="mailto:{{ section.settings.email_address }}" class="text-white hover:text-zinc-300 transition-colors block text-[10px] lowercase tracking-normal font-semibold break-all">
                        {{ section.settings.email_address }}
                      </a>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- CENTER: Logo & Wordmark -->
      <a href="{{ routes.root_url }}" class="flex flex-row items-center justify-center cursor-pointer select-none gap-3 sm:gap-4 no-underline">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 150 }}" alt="Logo" class="h-10 w-10 sm:h-14 sm:w-14 lg:h-16 lg:w-16 object-contain transition-all" width="150" height="64">
        {%- else -%}
          <img src="{{ 'logo.png' | asset_url }}" alt="Logo" class="h-10 w-10 sm:h-14 sm:w-14 lg:h-16 lg:w-16 object-contain transition-all" onerror="this.style.display='none';" width="64" height="64">
        {%- endif -%}
        <span class="transition-all leading-none text-2xl sm:text-3xl lg:text-4xl apricity-wordmark" style="color: {{ section.settings.wordmark_color | default: '#3d4a6b' }};">
          {{ section.settings.wordmark_text | default: 'APRICITY' }}
        </span>
      </a>

      <!-- RIGHT: Compact Flag Language Switcher, Currency & Icons -->
      <div class="flex items-center gap-3 sm:gap-5 lg:gap-6 justify-end text-sm sm:text-[17px] font-mono-street capitalize tracking-[0.1em] font-medium">
        
        <!-- Desktop Compact Flag Switcher -->
        <div class="lang-switcher hidden lg:flex items-center gap-2">
          <!-- Saudi Flag (Arabic) -->
          <a 
            href="/ar{{ request.path | remove_first: '/ar' }}" 
            class="flag-btn inline-block overflow-hidden transition-all duration-200 shrink-0 {% if request.locale.iso_code == 'ar' %}ring-2 ring-white scale-110 opacity-100{% else %}opacity-40 hover:opacity-90 hover:scale-105{% endif %}"
            style="width: 20px; height: 20px; min-width: 20px; border-radius: 9999px;"
            title="العربية"
            aria-label="العربية"
          >
            <svg style="width: 100%; height: 100%; display: block; object-fit: cover;" viewBox="0 0 640 480">
              <path fill="#007a3d" d="M0 0h640v480H0z"/>
              <g fill="#fff">
                <path d="M170 310h300v16H170zm260-35c-15-5-25-15-30-25-10 15-20 20-40 25 15 5 25 15 30 25 10-15 20-20 40-25zM220 250h200v15H220z"/>
              </g>
            </svg>
          </a>

          <!-- UK Flag (English) -->
          <a 
            href="{{ request.path | remove_first: '/ar' | default: '/' }}" 
            class="flag-btn inline-block overflow-hidden transition-all duration-200 shrink-0 {% if request.locale.iso_code != 'ar' %}ring-2 ring-white scale-110 opacity-100{% else %}opacity-40 hover:opacity-90 hover:scale-105{% endif %}"
            style="width: 20px; height: 20px; min-width: 20px; border-radius: 9999px;"
            title="English"
            aria-label="English"
          >
            <svg style="width: 100%; height: 100%; display: block; object-fit: cover;" viewBox="0 0 640 480">
              <clipPath id="header-uk-clip-small"><circle cx="320" cy="240" r="320"/></clipPath>
              <g clip-path="url(#header-uk-clip-small)">
                <path fill="#012169" d="M0 0h640v480H0z"/>
                <path fill="#fff" d="m75 0 245 180L565 0h75v60L435 240l205 180v60h-75L320 300 75 480H0v-60l205-180L0 60V0z"/>
                <path fill="#c8102e" d="m425 285 215 155v40h-25L395 315zM0 440l190-140h35L35 480H0zM640 40 450 180h-35l190-140h35zM0 0l215 160h-35L0 25z"/>
                <path fill="#fff" d="M240 0h160v480H240zM0 160h640v160H0z"/>
                <path fill="#c8102e" d="M270 0h100v480H270zM0 190h640v100H0z"/>
              </g>
            </svg>
          </a>
        </div>

        {%- if localization.available_countries.size > 1 -%}
          <form action="/localization" method="POST" id="desktop-localization-form" class="hidden lg:block">
            <input type="hidden" name="_method" value="PUT">
            <input type="hidden" name="return_to" value="{{ request.path }}">
            <select
              name="country_code"
              onchange="document.getElementById('desktop-localization-form').submit()"
              class="bg-transparent text-current text-[11px] tracking-wider border border-current/20 rounded-full px-2.5 py-0.5 appearance-none cursor-pointer hover:border-current/50 transition-colors outline-none"
            >
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %} style="background:#000;color:#fff;">
                  {{ country.currency.iso_code }}
                </option>
              {%- endfor -%}
            </select>
          </form>
        {%- endif -%}

        <button class="search-drawer-trigger transition-colors flex items-center gap-1.5 p-1 hover:opacity-80 text-current" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="hidden md:inline">{{ section.settings.search_label | default: 'Search' }}</span>
        </button>

        <button class="cart-drawer-trigger relative transition-all flex items-center gap-1.5 p-1 hover:opacity-80 text-current" aria-label="Bag">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="text-sm">
            <span class="hidden sm:inline">{{ section.settings.cart_label | default: 'Cart' }} </span>(<span class="cart-count">{{ cart.item_count }}</span>)
          </span>
        </button>
      </div>

    </div>
  </nav>

  <!-- Mobile Drawer Overlay -->
  <div id="MobileNavDrawer" class="hidden lg:hidden fixed inset-0 bg-black/95 backdrop-blur-lg h-screen w-full transition-all duration-300 flex flex-col z-50">
    <!-- Mobile Menu Header -->
    <div class="flex items-center justify-between px-4 py-4 border-b border-zinc-800">
      <button class="mobile-menu-close p-2 text-white">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <a href="{{ routes.root_url }}" class="flex items-center gap-2 no-underline">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 50 }}" alt="Logo" class="h-10 w-10 object-contain" width="50" height="50">
        {%- else -%}
          <img src="{{ 'logo.png' | asset_url }}" alt="Logo" class="h-10 w-10 object-contain" onerror="this.style.display='none';" width="50" height="50">
        {%- endif -%}
        <span class="text-white font-mono-street tracking-[0.2em] text-sm uppercase">{{ section.settings.wordmark_text | default: 'Apricity' }}</span>
      </a>
      <div class="flex items-center gap-3">
        <button class="search-drawer-trigger p-2 text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <a href="{{ routes.cart_url }}" class="p-2 text-white relative cart-drawer-trigger">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="cart-count-badge absolute -top-1 -right-1 bg-white text-black text-[9px] font-bold rounded-full w-4 h-4 flex items-center justify-center leading-none {% if cart.item_count == 0 %}hidden{% endif %}">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
    <div class="flex flex-col space-y-6 font-mono-street text-lg tracking-[0.25em] capitalize text-center pt-10 px-6 flex-1">
      {%- assign main_menu_links = linklists[section.settings.menu].links -%}
      {%- if main_menu_links == blank or main_menu_links.size == 0 -%}
        <a href="{{ shop.url }}/?filter=men" class="py-2 transition-colors text-zinc-400 hover:text-white">Men</a>
        <a href="{{ shop.url }}/?filter=women" class="py-2 transition-colors text-zinc-400 hover:text-white">Women</a>
        <a href="{{ shop.url }}/?filter=new-drops" class="py-2 transition-colors text-zinc-400 hover:text-white">New Drops</a>
        {%- if section.settings.show_the_rule -%}
          <a href="{{ section.settings.the_rule_link | default: '/pages/our-story' }}" class="py-2 transition-colors text-zinc-400 hover:text-white no-underline normal-case the-rule-trigger-mobile">
            {{ section.settings.the_rule_text | default: 'The Rule' }}
          </a>
        {%- endif -%}
        <a href="{{ shop.url }}/?filter=sale" class="py-2 transition-colors text-zinc-400 hover:text-white">Sale</a>
      {%- else -%}
        {%- for link in main_menu_links -%}
          <a href="{{ link.url }}" class="py-2 transition-colors text-zinc-400 hover:text-white {% if link.active %}text-white font-bold{% endif %}">
            {{ link.title }}
          </a>
        {%- endfor -%}
        {%- if section.settings.show_the_rule -%}
          <a href="{{ section.settings.the_rule_link | default: '/pages/our-story' }}" class="py-2 transition-colors text-zinc-400 hover:text-white no-underline normal-case the-rule-trigger-mobile">
            {{ section.settings.the_rule_text | default: 'The Rule' }}
          </a>
        {%- endif -%}
      {%- endif -%}

      <!-- Mobile Language & Currency Selectors -->
      <div class="pt-4 flex flex-col items-center justify-center gap-4">
        <!-- Mobile Flag Switcher -->
        <div class="flex items-center gap-3">
          <a 
            href="/ar{{ request.path | remove_first: '/ar' }}" 
            class="flex items-center gap-2 px-3.5 py-1.5 rounded-full transition-all border {% if request.locale.iso_code == 'ar' %}bg-zinc-800 text-white border-zinc-600 font-bold{% else %}text-zinc-400 border-zinc-800 opacity-60{% endif %}"
          >
            <div class="w-4 h-4 rounded-full overflow-hidden shrink-0">
              <svg class="w-full h-full object-cover" viewBox="0 0 640 480">
                <path fill="#007a3d" d="M0 0h640v480H0z"/>
                <g fill="#fff">
                  <path d="M170 310h300v16H170zm260-35c-15-5-25-15-30-25-10 15-20 20-40 25 15 5 25 15 30 25 10-15 20-20 40-25zM220 250h200v15H220z"/>
                </g>
              </svg>
            </div>
            <span class="text-xs">العربية</span>
          </a>

          <a 
            href="{{ request.path | remove_first: '/ar' | default: '/' }}" 
            class="flex items-center gap-2 px-3.5 py-1.5 rounded-full transition-all border {% if request.locale.iso_code != 'ar' %}bg-zinc-800 text-white border-zinc-600 font-bold{% else %}text-zinc-400 border-zinc-800 opacity-60{% endif %}"
          >
            <div class="w-4 h-4 rounded-full overflow-hidden shrink-0">
              <svg class="w-full h-full object-cover" viewBox="0 0 640 480">
                <clipPath id="mobile-uk-clip-sm"><circle cx="320" cy="240" r="320"/></clipPath>
                <g clip-path="url(#mobile-uk-clip-sm)">
                  <path fill="#012169" d="M0 0h640v480H0z"/>
                  <path fill="#fff" d="m75 0 245 180L565 0h75v60L435 240l205 180v60h-75L320 300 75 480H0v-60l205-180L0 60V0z"/>
                  <path fill="#c8102e" d="m425 285 215 155v40h-25L395 315zM0 440l190-140h35L35 480H0zM640 40 450 180h-35l190-140h35zM0 0l215 160h-35L0 25z"/>
                  <path fill="#fff" d="M240 0h160v480H240zM0 160h640v160H0z"/>
                  <path fill="#c8102e" d="M270 0h100v480H270zM0 190h640v100H0z"/>
                </g>
              </svg>
            </div>
            <span class="text-xs">English</span>
          </a>
        </div>

        {%- if localization.available_countries.size > 1 -%}
          <form action="/localization" method="POST" id="mobile-localization-form">
            <input type="hidden" name="_method" value="PUT">
            <input type="hidden" name="return_to" value="{{ request.path }}">
            <div class="relative inline-flex items-center gap-2">
              <span class="text-zinc-400 text-[10px] tracking-widest uppercase">{{ localization.country.currency.iso_code }}</span>
              <select
                name="country_code"
                onchange="document.getElementById('mobile-localization-form').submit()"
                class="bg-transparent text-zinc-400 text-[11px] tracking-wider border border-zinc-700 rounded-full px-3 py-1.5 appearance-none cursor-pointer hover:border-zinc-400 transition-colors outline-none"
              >
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
            </div>
          </form>
        {%- endif -%}
      </div>

      <!-- Mobile Contact Info -->
      {%- if section.settings.show_contact != false -%}
        <div class="pt-6 border-t border-zinc-800 flex flex-col items-center gap-3">
          <span class="text-zinc-500 text-[10px] tracking-[0.2em] font-bold">{{ section.settings.contact_us_label | default: 'Contact Us' }}</span>
          <div class="flex flex-col items-center gap-2">
            {%- if section.settings.whatsapp_number != blank -%}
              <a href="{{ section.settings.whatsapp_url | default: 'https://wa.me/966536470644' }}" target="_blank" rel="noopener noreferrer" class="text-white hover:text-zinc-300 font-semibold text-xs tracking-wider">
                WhatsApp: {{ section.settings.whatsapp_number }}
              </a>
            {%- endif -%}
            {%- if section.settings.email_address != blank -%}
              <a href="mailto:{{ section.settings.email_address }}" class="text-white hover:text-zinc-300 font-semibold text-[11px] lowercase tracking-normal">
                {{ section.settings.email_address }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Close button anchored at the bottom of the drawer -->
    <div class="px-6 pb-16 pt-4 flex justify-center">
      <button class="mobile-menu-close flex items-center gap-2 px-8 py-3 border border-zinc-700 text-zinc-400 hover:text-white hover:border-zinc-400 font-mono-street text-[11px] uppercase tracking-widest transition-colors" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg> {{ section.settings.close_label | default: 'Close' }}
      </button>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.querySelector('.main-navbar');
    const mobileMenuOpenBtn = document.querySelector('.mobile-menu-trigger');
    const mobileMenuCloseBtn = document.querySelector('.mobile-menu-close');
    const mobileDrawer = document.getElementById('MobileNavDrawer');

    let mobileMenuOpen = false;

    // Scroll state toggler
    const handleScroll = () => {
      if (mobileMenuOpen) return;

      const isScrolled = window.scrollY > 50;
      const langSwitcher = navbar.querySelector('.lang-switcher');

      if (isScrolled) {
        navbar.classList.remove('bg-gradient-to-b', 'from-black/50', 'to-transparent', 'text-white');
        navbar.classList.add('bg-[#faf9f7]/85', 'backdrop-blur-md', 'border-b', 'border-zinc-200/40', 'shadow-sm', 'text-[#1a1a1a]');

        navbar.querySelectorAll('.nav-link-hover').forEach(el => {
          el.classList.remove('text-white/70');
          el.classList.add('text-zinc-500');
        });
        navbar.querySelectorAll('.search-drawer-trigger, .cart-drawer-trigger').forEach(el => {
          el.classList.remove('text-white');
          el.classList.add('text-[#1a1a1a]');
        });
        if (langSwitcher) {
          langSwitcher.querySelectorAll('.flag-btn.ring-white').forEach(el => {
            el.classList.remove('ring-white');
            el.classList.add('ring-zinc-950');
          });
        }
      } else {
        navbar.classList.add('bg-gradient-to-b', 'from-black/50', 'to-transparent', 'text-white');
        navbar.classList.remove('bg-[#faf9f7]/85', 'backdrop-blur-md', 'border-b', 'border-zinc-200/40', 'shadow-sm', 'text-[#1a1a1a]');

        navbar.querySelectorAll('.nav-link-hover').forEach(el => {
          el.classList.remove('text-zinc-500');
          el.classList.add('text-white/70');
        });
        navbar.querySelectorAll('.search-drawer-trigger, .cart-drawer-trigger').forEach(el => {
          el.classList.remove('text-[#1a1a1a]');
          el.classList.add('text-white');
        });
        if (langSwitcher) {
          langSwitcher.querySelectorAll('.flag-btn.ring-zinc-950').forEach(el => {
            el.classList.remove('ring-zinc-950');
            el.classList.add('ring-white');
          });
        }
      }
    };

    window.addEventListener('scroll', handleScroll);
    handleScroll();

    if (mobileMenuOpenBtn) {
      mobileMenuOpenBtn.addEventListener('click', () => {
        mobileMenuOpen = true;
        mobileDrawer.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
        navbar.classList.remove('bg-gradient-to-b', 'from-black/50', 'to-transparent', 'bg-[#faf9f7]/85', 'backdrop-blur-md', 'border-zinc-200/40', 'shadow-sm', 'text-[#1a1a1a]');
        navbar.classList.add('bg-black/95', 'backdrop-blur-md', 'border-b', 'border-zinc-800', 'text-white');
      });
    }

    if (mobileMenuCloseBtn) {
      mobileMenuCloseBtn.addEventListener('click', () => {
        mobileMenuOpen = false;
        mobileDrawer.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
        navbar.classList.remove('bg-black/95', 'border-zinc-800');
        handleScroll();
      });
    }

    mobileDrawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenuOpen = false;
        mobileDrawer.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
        navbar.classList.remove('bg-black/95', 'border-zinc-800');
        handleScroll();
      });
    });
  });
</script>

