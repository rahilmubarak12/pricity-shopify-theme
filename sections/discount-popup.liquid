{% comment %}
  Discount Popup Section
  Sticky bottom bar triggers a luxury modal showcasing promo codes with clipboard copy functionality.
{% endcomment %}

<div id="DiscountPopupSection" class="discount-popup-section">
  <!-- Sticky Bottom Bar -->
  <div class="discount-sticky-bar fixed bottom-6 left-4 right-20 sm:left-1/2 sm:right-auto sm:-translate-x-1/2 z-[9998] bg-white text-[#1a1a1a] shadow-2xl rounded-2xl py-4 px-6 flex items-center justify-center gap-3 cursor-pointer hover:shadow-xl transition-all sm:w-auto sm:max-w-xs select-none">
    <span class="font-mono-street text-[11px] uppercase tracking-[0.2em] whitespace-nowrap">
      {{ section.settings.sticky_text | default: "Want 15% off? Tap here" }}
    </span>
    <span class="text-base">👀</span>
  </div>

  <!-- Popup Modal Overlay -->
  <div class="discount-modal-overlay hidden fixed inset-0 z-[9999] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300">
    <div class="discount-modal-content relative bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300">

      <!-- Close Button -->
      <button class="discount-modal-close absolute top-4 right-4 z-10 p-1.5 rounded-full text-zinc-400 hover:text-zinc-700 hover:bg-zinc-100 transition-colors" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" x2="6" y1="6" y2="18"></line>
          <line x1="6" x2="18" y1="6" y2="18"></line>
        </svg>
      </button>

      <!-- Top Black Band -->
      <div class="bg-[#1a1a1a] px-8 py-6 text-center">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 100 }}" alt="Logo" class="h-10 w-10 object-contain mx-auto mb-3 opacity-80" width="1000" height="1000">
        {%- else -%}
          <img src="{{ 'logo.png' | asset_url }}" alt="Logo" class="h-10 w-10 object-contain mx-auto mb-3 opacity-80" onerror="this.style.display='none';" width="1000" height="1000">
        {%- endif -%}
        <p class="font-mono-street text-[10px] tracking-[0.3em] text-zinc-400 uppercase mb-1">
          {{ section.settings.welcome_text | default: 'Welcome to' }}
        </p>
        <h2 class="text-white font-heading font-extrabold text-2xl tracking-[0.2em] uppercase">
          {{ section.settings.brand_text | default: 'APRICITY' }}
        </h2>
      </div>

      <!-- Main Content -->
      <div class="px-8 py-8 text-center flex flex-col items-center gap-5">

        <!-- Offer 1 -->
        <div class="w-full border border-zinc-100 rounded-xl px-6 py-4 bg-zinc-50">
          <p class="font-heading font-bold text-3xl text-[#1a1a1a] mb-1">
            {{ section.settings.offer_1_title | default: '15% Off' }}
          </p>
          <p class="text-zinc-500 text-sm font-light">
            {{ section.settings.offer_1_description | default: 'when you purchase two or more items' }}
          </p>
        </div>

        <!-- Offer 2 -->
        <div class="w-full border border-zinc-100 rounded-xl px-6 py-4 bg-zinc-50 flex items-center justify-center gap-3">
          <span class="text-2xl">{{ section.settings.offer_2_flag | default: '🇸🇦' }}</span>
          <p class="text-zinc-700 text-sm font-light">
            {{ section.settings.offer_2_text | default: 'Free shipping with no minimum order' }}
          </p>
        </div>

        <!-- Email sign-up (Effeect, Nov 2026): replaces the APY-15 code box. Customer form tagged "newsletter" = same as the footer, so Shopify Messaging sends the NEW10 welcome email. -->
        <style>
          #DiscountPopupSection .apy-popup-note{font-size:13px;line-height:1.5;color:#71717a;margin:0}
          #DiscountPopupSection .apy-popup-form{width:100%}
          #DiscountPopupSection .apy-popup-row{display:flex;gap:8px;width:100%}
          #DiscountPopupSection .apy-popup-email{flex:1;min-width:0;border:1px solid #e4e4e7;border-radius:12px;padding:12px 14px;font-size:16px;color:#1a1a1a;background:#fff}
          #DiscountPopupSection .apy-popup-email:focus{outline:none;border-color:#1a1a1a}
          #DiscountPopupSection .apy-popup-submit{flex-shrink:0;border:0;border-radius:12px;background:#1a1a1a;color:#fff;padding:12px 16px;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;white-space:nowrap}
          #DiscountPopupSection .apy-popup-success{width:100%;border:1px solid #a7f3d0;background:#ecfdf5;color:#047857;border-radius:12px;padding:12px 14px;font-size:14px;line-height:1.5;margin:0}
          #DiscountPopupSection .apy-popup-error{color:#dc2626;font-size:12px;margin:8px 0 0}
          /* Effeect (Nov 2026): hide the Inbox chat button while the pop-up is open - on phones it covered the Get My 10% button */
          body:has(#DiscountPopupSection .discount-modal-overlay:not(.hidden)) shopify-chat{display:none !important}
        </style>
        <p class="apy-popup-note">
          {{ section.settings.signup_text | default: "Enter your email and we'll send your code." }}
        </p>
        {%- form 'customer', id: 'PopupNewsletterForm', class: 'apy-popup-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, popup">
          {%- if form.posted_successfully? -%}
            <p class="apy-popup-success">
              {{ section.settings.success_text | default: "You're in! Check your inbox for your 10% code." }}
            </p>
          {%- else -%}
            <div class="apy-popup-row">
              <input class="apy-popup-email" type="email" name="contact[email]" required autocomplete="email" aria-label="{{ section.settings.email_placeholder | default: 'Your email' | escape }}" placeholder="{{ section.settings.email_placeholder | default: 'Your email' | escape }}">
              <button class="apy-popup-submit" type="submit">
                {{ section.settings.signup_button_text | default: 'Get My 10%' }}
              </button>
            </div>
            {%- if form.errors -%}
              <p class="apy-popup-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

        <!-- Dismiss Button -->
        <button class="discount-dismiss text-[11px] text-zinc-400 font-mono-street uppercase tracking-widest hover:text-zinc-600 transition-colors">
          {{ section.settings.no_thanks_text | default: 'No thanks' }}
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('DiscountPopupSection');
    if (!section) return;

    const stickyBar = section.querySelector('.discount-sticky-bar');
    const overlay = section.querySelector('.discount-modal-overlay');
    const content = section.querySelector('.discount-modal-content');
    const closeBtn = section.querySelector('.discount-modal-close');
    const dismissBtn = section.querySelector('.discount-dismiss');
    if (!stickyBar || !overlay || !content) return;

    // Show modal function
    const openModal = () => {
      overlay.classList.remove('hidden');
      // Force trigger reflow
      overlay.offsetHeight;
      overlay.classList.remove('opacity-0');
      overlay.classList.add('opacity-100');
      content.classList.remove('scale-95');
      content.classList.add('scale-100');
      document.body.classList.add('overflow-hidden');
    };

    // Close modal function
    const closeModal = () => {
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0');
      content.classList.remove('scale-100');
      content.classList.add('scale-95');
      document.body.classList.remove('overflow-hidden');
      setTimeout(() => {
        overlay.classList.add('hidden');
      }, 300);
    };

    stickyBar.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (dismissBtn) dismissBtn.addEventListener('click', closeModal);

    // Close on click outside content
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closeModal();
      }
    });

    // Effeect (Nov 2026): after the sign-up form posts, the page reloads at #PopupNewsletterForm,
    // so reopen the popup to show the thank-you (or error) message. Hide the bar once signed up.
    const signedUp = !!section.querySelector('.apy-popup-success');
    if (window.location.hash === '#PopupNewsletterForm') openModal();
    try {
      if (signedUp) localStorage.setItem('apy_popup_signed_up', '1');
      if (!signedUp && localStorage.getItem('apy_popup_signed_up') === '1') stickyBar.style.display = 'none';
    } catch (e) {}
  });
</script>

