    },
    {
      "type": "text",
      "id": "cat_men_label",
      "label": "Men (EN)",
      "default": "Men"
    },
    {
      "type": "text",
      "id": "cat_women_label",
      "label": "Women (EN)",
      "default": "Women"
    },
    {
      "type": "text",
      "id": "cat_sale_label",
      "label": "Sale (EN)",
      "default": "Sale"
    },
    {
      "type": "header",
      "content": "العناوين العربية (Arabic)"
    },
    {
      "type": "text",
      "id": "subtitle_ar",
      "label": "العنوان الفرعي (AR)",
      "default": "الكتالوج"
    },
    {
      "type": "text",
      "id": "title_ar",
      "label": "العنوان الرئيسي (AR)",
      "default": "التشكيلة"
    },
    {
      "type": "header",
      "content": "أسماء الفئات الرئيسية (عربي)"
    },
    {
      "type": "text",
      "id": "cat_all_label_ar",
      "label": "فلتر الكل (AR)",
      "default": "الكل"
    },
    {
      "type": "text",
      "id": "cat_new_label_ar",
      "label": "فلتر وصل حديثاً (AR)",
      "default": "وصل حديثاً"
    },
    {
      "type": "text",
      "id": "cat_men_label_ar",
      "label": "فلتر رجال (AR)",
      "default": "رجال"
    },
    {
      "type": "text",
      "id": "cat_women_label_ar",
      "label": "فلتر نساء (AR)",
      "default": "نساء"
    },
    {
      "type": "text",
