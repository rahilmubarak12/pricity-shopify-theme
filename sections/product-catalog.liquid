{% comment %}
  Product Catalog Section
  Renders product grids with instant category and subcategory filtering, OOS handling, and size selector triggers.
{% endcomment %}

{%- liquid
  assign selected_collection = section.settings.collection
  assign collection_obj = collections[selected_collection] | default: collections.all
  assign products_limit = section.settings.products_to_show | default: 48
-%}

<section class="py-24 px-6 md:px-16 max-w-7xl mx-auto" id="shop-catalog" data-section-id="{{ section.id }}" data-lang="{{ request.locale.iso_code }}">

  <!-- HEADER -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-zinc-200 gap-6">
    <div>
      <span class="text-[11px] font-mono-street tracking-[0.25em] text-zinc-400 uppercase">
        {%- if request.locale.iso_code == 'ar' -%}
          {{ section.settings.subtitle_ar | default: 'الكتالوج' }}
        {%- else -%}
          {{ section.settings.subtitle | default: 'Catalog' }}
        {%- endif -%}
      </span>

      {%- liquid
        if request.locale.iso_code == 'ar'
          assign base_title = section.settings.title_ar | default: 'التشكيلة'
          assign suffix = ''
          if collection_obj.handle == 'new-drops'
            assign suffix = ' · وصل حديثاً'
          elsif collection_obj.handle == 'sale' or collection_obj.handle == 'archival-sale'
            assign suffix = ' · التخفيضات'
          elsif collection_obj.handle == 'summer-capsule' or collection_obj.handle == 'summer-drop'
            assign suffix = ' · تشكيلة الصيف'
          endif
        else
          assign base_title = section.settings.title | default: 'The Collection'
          assign suffix = ''
          if collection_obj.handle == 'new-drops'
            assign suffix = ' · New Drops'
          elsif collection_obj.handle == 'sale' or collection_obj.handle == 'archival-sale'
            assign suffix = ' · Archival Sale'
          elsif collection_obj.handle == 'summer-capsule' or collection_obj.handle == 'summer-drop'
            assign suffix = ' · Summer Capsule'
          endif
        endif
        assign final_title = base_title | append: suffix
      -%}
      <h2 class="catalog-title font-heading font-extrabold text-3xl md:text-5xl uppercase text-[#1a1a1a] mt-1" 
          data-title-base="{{ final_title }}">
        {{ final_title }}
      </h2>

      <p class="catalog-count text-[11px] text-zinc-400 font-mono-street tracking-wider mt-2 uppercase">
        {%- if request.locale.iso_code == 'ar' -%}
          عرض <span class="count-num">{{ collection_obj.products_count }}</span> قطعة مميزة
        {%- else -%}
          Showing <span class="count-num">{{ collection_obj.products_count }}</span> premium pieces
        {%- endif -%}
      </p>
    </div>

    <!-- CATEGORY TOGGLE -->
    <div class="category-filters flex items-center gap-6 font-mono-street text-[11px] uppercase tracking-widest">
      <button type="button" class="category-filter-btn pb-0.5 transition text-[#1a1a1a] font-bold border-b border-[#1a1a1a]" data-category="all">
        {%- if request.locale.iso_code == 'ar' -%}
          {{ section.settings.cat_all_label_ar | default: 'الكل' }}
        {%- else -%}
          {{ section.settings.cat_all_label | default: 'All' }}
        {%- endif -%}
      </button>
      <button type="button" class="category-filter-btn pb-0.5 transition text-zinc-400 hover:text-[#1a1a1a]" data-category="new-drops">
        {%- if request.locale.iso_code == 'ar' -%}
          {{ section.settings.cat_new_label_ar | default: 'وصل حديثاً' }}
        {%- else -%}
          {{ section.settings.cat_new_label | default: 'New Drops' }}
        {%- endif -%}
      </button>
      <button type="button" class="category-filter-btn pb-0.5 transition text-zinc-400 hover:text-[#1a1a1a]" data-category="men">
        {%- if request.locale.iso_code == 'ar' -%}
          {{ section.settings.cat_men_label_ar | default: 'رجال' }}
        {%- else -%}
          {{ section.settings.cat_men_label | default: 'Men' }}
        {%- endif -%}
      </button>
      <button type="button" class="category-filter-btn pb-0.5 transition text-zinc-400 hover:text-[#1a1a1a]" data-category="women">
        {%- if request.locale.iso_code == 'ar' -%}
          {{ section.settings.cat_women_label_ar | default: 'نساء' }}
        {%- else -%}
          {{ section.settings.cat_women_label | default: 'Women' }}
        {%- endif -%}
      </button>
      <button type="button" class="category-filter-btn pb-0.5 transition text-zinc-400 hover:text-[#1a1a1a]" data-category="sale">
        {%- if request.locale.iso_code == 'ar' -%}
          {{ section.settings.cat_sale_label_ar | default: 'التخفيضات' }}
        {%- else -%}
          {{ section.settings.cat_sale_label | default: 'Sale' }}
        {%- endif -%}
      </button>
    </div>
  </div>

  <!-- SUBCATEGORY PILLS -->
  <div class="subcategory-filters flex items-center gap-3 overflow-x-auto pb-6 scrollbar-none mb-12 select-none">
    <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-[#1a1a1a] text-white border-[#1a1a1a]" data-subcategory="all">
      {%- if request.locale.iso_code == 'ar' -%}
        {{ section.settings.cat_all_label_ar | default: 'الكل' }}
      {%- else -%}
        {{ section.settings.cat_all_label | default: 'All' }}
      {%- endif -%}
    </button>
    {%- assign subcat_blocks = section.blocks | where: 'type', 'subcategory_filter' -%}
    {%- if subcat_blocks.size > 0 -%}
      {%- for block in subcat_blocks -%}
        <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="{{ block.settings.key | escape }}" {{ block.shopify_attributes }}>
          {%- if request.locale.iso_code == 'ar' -%}
            {{ block.settings.label_ar | default: block.settings.label | escape }}
          {%- else -%}
            {{ block.settings.label | escape }}
          {%- endif -%}
        </button>
      {%- endfor -%}
    {%- else -%}
      <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="summer">
        {% if request.locale.iso_code == 'ar' %}تشكيلة الصيف{% else %}Summer Collection{% endif %}
      </button>
      <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="hoodie">
        {% if request.locale.iso_code == 'ar' %}هوديز{% else %}Hoodies{% endif %}
      </button>
      <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="shirt">
        {% if request.locale.iso_code == 'ar' %}أطقم{% else %}Sets{% endif %}
      </button>
      <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="sweatshirt">
        {% if request.locale.iso_code == 'ar' %}سويت شيرت{% else %}Sweatshirts{% endif %}
      </button>
      <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="t-shirt">
        {% if request.locale.iso_code == 'ar' %}تيشيرتات{% else %}T-Shirts & Tops{% endif %}
      </button>
    {%- endif -%}
  </div>

  <!-- EMPTY STATE -->
  <div class="catalog-empty-state hidden flex flex-col items-center justify-center py-32 text-center gap-4">
    <p class="font-mono-street text-xs uppercase tracking-[0.25em] text-zinc-400">
      {% if request.locale.iso_code == 'ar' %}لم يتم العثور على منتجات{% else %}No products found{% endif %}
    </p>
    <p class="text-zinc-300 text-sm font-light">
      {% if request.locale.iso_code == 'ar' %}جرب تعديل خيارات التصفية{% else %}Try adjusting your filters{% endif %}
    </p>
    <button type="button" class="catalog-reset-btn mt-2 px-8 py-3 bg-[#1a1a1a] text-white font-mono-street text-[11px] uppercase tracking-widest hover:bg-zinc-800 transition-colors">
      {% if request.locale.iso_code == 'ar' %}إعادة ضبط الفلاتر{% else %}Reset Filters{% endif %}
    </button>
  </div>

  <!-- GRID -->
  <div class="catalog-grid grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-3 gap-y-8 sm:gap-x-6 sm:gap-y-12">
    {%- liquid
      assign rendered_count = 0
      
      for product in collection_obj.products
        if rendered_count >= products_limit
          break
        endif

        assign is_winter = false
        assign title_lower = product.title | downcase
        if title_lower contains 'hoodie' or title_lower contains 'sweatshirt'
          assign is_winter = true
        else
          for tag in product.tags
            assign tag_lower = tag | downcase
            if tag_lower contains 'hoodie' or tag_lower contains 'sweatshirt'
              assign is_winter = true
              break
            endif
          endfor
        endif

        if is_winter == false
          render 'product-card', product: product
          assign rendered_count = rendered_count | plus: 1
        endif
      endfor

      for product in collection_obj.products
        if rendered_count >= products_limit
          break
        endif

        assign is_winter = false
        assign title_lower = product.title | downcase
        if title_lower contains 'hoodie' or title_lower contains 'sweatshirt'
          assign is_winter = true
        else
          for tag in product.tags
            assign tag_lower = tag | downcase
            if tag_lower contains 'hoodie' or tag_lower contains 'sweatshirt'
              assign is_winter = true
              break
            endif
          endfor
        endif

        if is_winter == true
          render 'product-card', product: product
          assign rendered_count = rendered_count | plus: 1
        endif
      endfor
    -%}
    {%- if rendered_count == 0 -%}
      <p class="text-center col-span-full py-12 text-zinc-400 font-mono-street text-xs uppercase">
        {% if request.locale.iso_code == 'ar' %}لا توجد منتجات في هذه المجموعة حالياً.{% else %}No products in this collection.{% endif %}
      </p>
    {%- endif -%}
  </div>

</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const catalog = document.getElementById('shop-catalog');
    if (!catalog) return;

    const isArabic = catalog.getAttribute('data-lang') === 'ar';
    const cards = catalog.querySelectorAll('.product-card');
    const categoryBtns = catalog.querySelectorAll('.category-filter-btn');
    const emptyState = catalog.querySelector('.catalog-empty-state');
    const countText = catalog.querySelector('.catalog-count');
    const titleText = catalog.querySelector('.catalog-title');
    const titleBase = titleText.getAttribute('data-title-base');
    const resetBtn = catalog.querySelector('.catalog-reset-btn');

    let activeCategory = 'all';
    let activeSubcategory = 'all';

    const getSubcategoryBtns = () => catalog.querySelectorAll('.subcategory-filter-btn');

    const updateSubcategoryPillsUI = (activeKey) => {
      getSubcategoryBtns().forEach(b => {
        const isSelected = b.getAttribute('data-subcategory') === activeKey;
        b.style.color = '';
        if (isSelected) {
          b.classList.remove('bg-white', 'text-zinc-400', 'border-zinc-200', 'hover:text-[#1a1a1a]');
          b.classList.add('bg-[#1a1a1a]', 'text-white', 'border-[#1a1a1a]');
        } else {
          b.classList.remove('bg-[#1a1a1a]', 'text-white', 'border-[#1a1a1a]');
          b.classList.add('bg-white', 'text-zinc-400', 'border-zinc-200', 'hover:text-[#1a1a1a]');
        }
      });
    };

    const filterGrid = () => {
      let visibleCount = 0;
      
      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const sub = card.getAttribute('data-subcategory');
        const collections = (card.getAttribute('data-collections') || '').split(',');
        const isOnSale = card.getAttribute('data-on-sale') === 'true';
        
        let matchesCategory = false;
        if (activeCategory === 'all') {
          matchesCategory = true;
        } else if (activeCategory === 'new-drops') {
          const tags = (card.getAttribute('data-tags') || '').split(',');
          matchesCategory = collections.includes('new-drops') || 
                            collections.includes('new_drops') || 
                            collections.includes('newdrops') || 
                            tags.includes('new-drops') || 
                            tags.includes('newdrops') || 
                            tags.includes('new drops');
        } else if (activeCategory === 'men') {
          matchesCategory = (cat === 'men' || cat === 'unisex');
        } else if (activeCategory === 'women') {
          matchesCategory = (cat === 'women' || cat === 'unisex');
        } else if (activeCategory === 'sale') {
          matchesCategory = (isOnSale || collections.includes('sale') || collections.includes('archival-sale'));
        }

        let matchesSubcategory = false;
        if (activeSubcategory === 'all') {
          matchesSubcategory = true;
        } else if (activeSubcategory === 'summer') {
          matchesSubcategory = (sub !== 'hoodie' && sub !== 'sweatshirt');
        } else {
          matchesSubcategory = (sub === activeSubcategory);
        }

        if (matchesCategory && matchesSubcategory) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (isArabic) {
        countText.innerHTML = `عرض <span class="count-num">${visibleCount}</span> قطعة مميزة`;
      } else {
        countText.innerHTML = `Showing <span class="count-num">${visibleCount}</span> premium pieces`;
      }

      if (activeCategory === 'men') {
        titleText.textContent = isArabic ? "تشكيلة الرجال" : "Men's Archive";
      } else if (activeCategory === 'women') {
        titleText.textContent = isArabic ? "تشكيلة النساء" : "Women's Archive";
      } else if (activeCategory === 'sale') {
        titleText.textContent = isArabic ? "التخفيضات" : "Archival Sale";
      } else if (activeCategory === 'new-drops') {
        titleText.textContent = isArabic ? "وصل حديثاً" : "New Drops";
      } else {
        titleText.textContent = titleBase;
      }

      if (visibleCount === 0 && cards.length > 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    };

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach(b => {
          b.classList.remove('text-[#1a1a1a]', 'font-bold', 'border-b', 'border-[#1a1a1a]');
          b.classList.add('text-zinc-400');
        });
        btn.classList.add('text-[#1a1a1a]', 'font-bold', 'border-b', 'border-[#1a1a1a]');
        btn.classList.remove('text-zinc-400');

        activeCategory = btn.getAttribute('data-category');
        activeSubcategory = 'all';
        updateSubcategoryPillsUI('all');
        filterGrid();
      });
    });

    const setupSubcategoryHandlers = () => {
      const subcategoryBtns = getSubcategoryBtns();
      subcategoryBtns.forEach(btn => {
        btn.onclick = () => {
          activeSubcategory = btn.getAttribute('data-subcategory');
          updateSubcategoryPillsUI(activeSubcategory);
          filterGrid();
        };
      });
    };
    setupSubcategoryHandlers();

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        const defaultCategoryBtn = catalog.querySelector('.category-filter-btn[data-category="all"]');
        const defaultSubcategoryBtn = catalog.querySelector('.subcategory-filter-btn[data-subcategory="all"]');
        if (defaultCategoryBtn) defaultCategoryBtn.click();
        if (defaultSubcategoryBtn) defaultSubcategoryBtn.click();
      });
    }

    const urlParams = new URLSearchParams(window.location.search);
    const filterParam = urlParams.get('filter');
    if (filterParam) {
      const targetBtn = catalog.querySelector(`.category-filter-btn[data-category="${filterParam}"]`);
      if (targetBtn) {
        targetBtn.click();
        catalog.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    const handleFilterLinkClick = (e) => {
      const link = e.target.closest('a');
      if (!link) return;

      const href = link.getAttribute('href');
      if (!href) return;

      const isHomepage = window.location.pathname === '/' || window.location.pathname === '' || window.location.pathname === '/ar' || window.location.pathname === '/ar/';
      if (!isHomepage) return;

      let category = null;
      const text = link.textContent.toLowerCase();
      
      if (href.includes('/collections/men') || href.includes('filter=men') || href === '#men') {
        category = 'men';
      } else if (href.includes('/collections/women') || href.includes('filter=women') || href === '#women') {
        category = 'women';
      } else if (href.includes('/collections/new-drops') || href.includes('/collections/newdrops') || href.includes('filter=new-drops') || href.includes('filter=newdrops') || href === '#new-drops') {
        category = 'new-drops';
      } else if (href.includes('/collections/sale') || href.includes('filter=sale') || href === '#sale') {
        category = 'sale';
      } else if (href.includes('/collections/all') || href.includes('filter=all') || href === '#all') {
        category = 'all';
      } else if (href.includes('#shop-catalog') || href === '#') {
        if (text.includes('women') || text.includes('نساء')) {
          category = 'women';
        } else if (text.includes('men') || text.includes('رجال')) {
          category = 'men';
        } else if (text.includes('new drops') || text.includes('وصل حديثاً')) {
          category = 'new-drops';
        } else if (text.includes('sale') || text.includes('تخفيضات')) {
          category = 'sale';
        } else if (text.includes('shop now') || text.includes('all') || text.includes('الكل') || text.includes('تسوق')) {
          category = 'all';
        }
      }

      if (category) {
        e.preventDefault();
        const btn = catalog.querySelector(`.category-filter-btn[data-category="${category}"]`);
        if (btn) {
          const mobileDrawer = document.getElementById('MobileNavDrawer');
          if (mobileDrawer && !mobileDrawer.classList.contains('hidden')) {
            const closeBtn = mobileDrawer.querySelector('.mobile-menu-close');
            if (closeBtn) closeBtn.click();
          }

          btn.click();
          catalog.scrollIntoView({ behavior: 'smooth', block: 'start' });
          
          if (category === 'all') {
            const url = new URL(window.location.href);
            url.searchParams.delete('filter');
            history.pushState(null, '', url.pathname + url.search);
          } else {
            history.pushState(null, '', `?filter=${category}`);
          }
        }
      }
    };

    document.addEventListener('click', handleFilterLinkClick);

    cards.forEach(card => {
      const mobileTrigger = card.querySelector('.mobile-quick-add-trigger');
      const mobilePopup = card.querySelector('.mobile-size-popup');
      
      if (mobileTrigger && mobilePopup) {
        mobileTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const isClosed = mobilePopup.classList.contains('hidden');
          catalog.querySelectorAll('.mobile-size-popup').forEach(pop => pop.classList.add('hidden'));

          if (isClosed) {
            mobilePopup.classList.remove('hidden');
          }
        });
      }
    });

    document.addEventListener('click', (e) => {
      if (e.target.closest('.mobile-size-popup') || e.target.closest('.mobile-quick-add-trigger') || e.target.closest('.quick-add-size-btn')) return;
      catalog.querySelectorAll('.mobile-size-popup').forEach(pop => pop.classList.add('hidden'));
    });

    document.addEventListener('click', (e) => {
      const sizeBtn = e.target.closest('.quick-add-size-btn');
      if (!sizeBtn || sizeBtn.disabled) return;
      e.preventDefault();
      e.stopPropagation();

      let variantId = sizeBtn.getAttribute('data-variant-id');
      if (!variantId) return;
      if (variantId.includes('/')) variantId = variantId.split('/').pop();
      variantId = parseInt(variantId, 10);
      if (isNaN(variantId)) return;

      const originalText = sizeBtn.textContent.trim();
      sizeBtn.disabled = true;
      sizeBtn.textContent = '...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1
        })
      })
      .then(res => {
        if (!res.ok) return res.json().then(err => Promise.reject(err));
        return res.json();
      })
      .then(item => {
        sizeBtn.textContent = '\u2713';
        document.dispatchEvent(new CustomEvent('cart:updated', {
          detail: { item: item, openDrawer: true }
        }));

        setTimeout(() => {
          sizeBtn.disabled = false;
          sizeBtn.textContent = originalText;
          const popup = sizeBtn.closest('.mobile-size-popup');
          if (popup) popup.classList.add('hidden');
        }, 1500);
      })
      .catch(err => {
        console.error('AJAX quick add failed:', err);
        sizeBtn.textContent = isArabic ? 'خطأ' : 'Error';
        setTimeout(() => {
          sizeBtn.disabled = false;
          sizeBtn.textContent = originalText;
        }, 1500);
      });
    });

  });
</script>

{% schema %}
{
  "name": "Product Catalog Grid",
  "settings": [
    {
      "type": "header",
      "content": "English Titles"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle (EN)",
      "default": "Catalog"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading (EN)",
      "default": "The Collection"
    },
    {
      "type": "header",
      "content": "Main Category Filter Labels (EN)"
    },
    {
      "type": "text",
      "id": "cat_all_label",
      "label": "All (EN)",
      "default": "All"
    },
    {
      "type": "text",
      "id": "cat_new_label",
      "label": "New Drops (EN)",
      "default": "New Drops"
    },
    {
      "type": "text",
      "id": "cat_men_label",
      "label": "Men (EN)",
      "default": "Men"
    },
    {
      "type": "text",
      "id": "cat_women_label",
      "label": "Women (EN)",
      "default": "Women"
    },
    {
      "type": "text",
      "id": "cat_sale_label",
      "label": "Sale (EN)",
      "default": "Sale"
    },
    {
      "type": "header",
      "content": "العناوين العربية (Arabic)"
    },
    {
      "type": "text",
      "id": "subtitle_ar",
      "label": "العنوان الفرعي (AR)",
      "default": "الكتالوج"
    },
    {
      "type": "text",
      "id": "title_ar",
      "label": "العنوان الرئيسي (AR)",
      "default": "التشكيلة"
    },
    {
      "type": "header",
      "content": "أسماء الفئات الرئيسية (عربي)"
    },
    {
      "type": "text",
      "id": "cat_all_label_ar",
      "label": "فلتر الكل (AR)",
      "default": "الكل"
    },
    {
      "type": "text",
      "id": "cat_new_label_ar",
      "label": "فلتر وصل حديثاً (AR)",
      "default": "وصل حديثاً"
    },
    {
      "type": "text",
      "id": "cat_men_label_ar",
