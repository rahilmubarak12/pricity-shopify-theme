{% comment %}
  Product Catalog Section
  Renders product grids with instant category and subcategory filtering, OOS handling, and size selector triggers.
  Fully bilingual (EN / AR) - Fixed filter execution.
{% endcomment %}

{%- liquid
  assign selected_collection = section.settings.collection
  assign collection_obj = collections[selected_collection] | default: collections.all
  assign products_limit = section.settings.products_to_show | default: 48
-%}

<section class="py-24 px-6 md:px-16 max-w-7xl mx-auto" id="shop-catalog" data-section-id="{{ section.id }}" data-lang="{{ request.locale.iso_code }}">

  <!-- HEADER -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-zinc-200 gap-6">
    <div>
      <span class="text-[11px] font-mono-street tracking-[0.25em] text-zinc-400 uppercase">
        {%- if request.locale.iso_code == 'ar' -%}
          {{ section.settings.subtitle_ar | default: 'الكتالوج' }}
        {%- else -%}
          {{ section.settings.subtitle | default: 'Catalog' }}
        {%- endif -%}
      </span>

      {%- liquid
        if request.locale.iso_code == 'ar'
          assign base_title = section.settings.title_ar | default: 'التشكيلة'
        else
          assign base_title = section.settings.title | default: 'The Collection'
        endif
      -%}
      <h2 class="catalog-title font-heading font-extrabold text-3xl md:text-5xl uppercase text-[#1a1a1a] mt-1" 
          data-title-base="{{ base_title }}">
        {{ base_title }}
      </h2>

      <p class="catalog-count text-[11px] text-zinc-400 font-mono-street tracking-wider mt-2 uppercase">
        {%- if request.locale.iso_code == 'ar' -%}
          عرض <span class="count-num">{{ collection_obj.products_count }}</span> قطعة مميزة
        {%- else -%}
          Showing <span class="count-num">{{ collection_obj.products_count }}</span> premium pieces
        {%- endif -%}
      </p>
    </div>

    <!-- 1. CATEGORY TOGGLE (TOP ROW) -->
    <div class="category-filters flex items-center gap-6 font-mono-street text-[11px] uppercase tracking-widest">
      <button type="button" class="category-filter-btn pb-0.5 transition text-[#1a1a1a] font-bold border-b border-[#1a1a1a]" data-category="all">
        {%- if request.locale.iso_code == 'ar' -%}{{ section.settings.cat_all_label_ar | default: 'الكل' }}{%- else -%}{{ section.settings.cat_all_label | default: 'All' }}{%- endif -%}
      </button>
      <button type="button" class="category-filter-btn pb-0.5 transition text-zinc-400 hover:text-[#1a1a1a]" data-category="new-drops">
        {%- if request.locale.iso_code == 'ar' -%}{{ section.settings.cat_new_label_ar | default: 'وصل حديثاً' }}{%- else -%}{{ section.settings.cat_new_label | default: 'New Drops' }}{%- endif -%}
      </button>
      <button type="button" class="category-filter-btn pb-0.5 transition text-zinc-400 hover:text-[#1a1a1a]" data-category="men">
        {%- if request.locale.iso_code == 'ar' -%}{{ section.settings.cat_men_label_ar | default: 'رجال' }}{%- else -%}{{ section.settings.cat_men_label | default: 'Men' }}{%- endif -%}
      </button>
      <button type="button" class="category-filter-btn pb-0.5 transition text-zinc-400 hover:text-[#1a1a1a]" data-category="women">
        {%- if request.locale.iso_code == 'ar' -%}{{ section.settings.cat_women_label_ar | default: 'نساء' }}{%- else -%}{{ section.settings.cat_women_label | default: 'Women' }}{%- endif -%}
      </button>
      <button type="button" class="category-filter-btn pb-0.5 transition text-zinc-400 hover:text-[#1a1a1a]" data-category="sale">
        {%- if request.locale.iso_code == 'ar' -%}{{ section.settings.cat_sale_label_ar | default: 'التخفيضات' }}{%- else -%}{{ section.settings.cat_sale_label | default: 'Sale' }}{%- endif -%}
      </button>
    </div>
  </div>

  <!-- 2. SUBCATEGORY PILLS (BOTTOM ROW) -->
  <div class="subcategory-filters flex items-center gap-3 overflow-x-auto pb-6 scrollbar-none mb-12 select-none">
    <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-[#1a1a1a] text-white border-[#1a1a1a]" data-subcategory="all">
      {%- if request.locale.iso_code == 'ar' -%}
        {{ section.settings.cat_all_label_ar | default: 'الكل' }}
      {%- else -%}
        {{ section.settings.cat_all_label | default: 'All' }}
      {%- endif -%}
    </button>
    
    {%- assign subcat_blocks = section.blocks | where: 'type', 'subcategory_filter' -%}
    {%- if subcat_blocks.size > 0 -%}
      {%- for block in subcat_blocks -%}
        <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="{{ block.settings.key | downcase | strip }}" {{ block.shopify_attributes }}>
          {%- if request.locale.iso_code == 'ar' -%}
            {{ block.settings.label_ar | default: block.settings.label | escape }}
          {%- else -%}
            {{ block.settings.label | escape }}
          {%- endif -%}
        </button>
      {%- endfor -%}
    {%- else -%}
      <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="summer">
        {% if request.locale.iso_code == 'ar' %}تشكيلة الصيف{% else %}Summer Collection{% endif %}
      </button>
      <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="hoodie">
        {% if request.locale.iso_code == 'ar' %}هوديز{% else %}Hoodies{% endif %}
      </button>
      <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="shirt">
        {% if request.locale.iso_code == 'ar' %}أطقم{% else %}Sets{% endif %}
      </button>
      <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="sweatshirt">
        {% if request.locale.iso_code == 'ar' %}سويت شيرت{% else %}Sweatshirts{% endif %}
      </button>
      <button type="button" class="subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200" data-subcategory="t-shirt">
        {% if request.locale.iso_code == 'ar' %}تيشيرتات وتوبات{% else %}T-Shirts & Tops{% endif %}
      </button>
    {%- endif -%}
  </div>

  <!-- EMPTY STATE -->
  <div class="catalog-empty-state hidden flex flex-col items-center justify-center py-32 text-center gap-4">
    <p class="font-mono-street text-xs uppercase tracking-[0.25em] text-zinc-400">
      {% if request.locale.iso_code == 'ar' %}لم يتم العثور على منتجات{% else %}No products found{% endif %}
    </p>
    <p class="text-zinc-300 text-sm font-light">
      {% if request.locale.iso_code == 'ar' %}جرب تعديل خيارات التصفية{% else %}Try adjusting your filters{% endif %}
    </p>
    <button type="button" class="catalog-reset-btn mt-2 px-8 py-3 bg-[#1a1a1a] text-white font-mono-street text-[11px] uppercase tracking-widest hover:bg-zinc-800 transition-colors">
      {% if request.locale.iso_code == 'ar' %}إعادة ضبط الفلاتر{% else %}Reset Filters{% endif %}
    </button>
  </div>

  <!-- GRID -->
  <div class="catalog-grid grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-3 gap-y-8 sm:gap-x-6 sm:gap-y-12">
    {%- for product in collection_obj.products limit: products_limit -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      <p class="text-center col-span-full py-12 text-zinc-400 font-mono-street text-xs uppercase">
        {% if request.locale.iso_code == 'ar' %}لا توجد منتجات في هذه المجموعة حالياً.{% else %}No products in this collection.{% endif %}
      </p>
    {%- endfor -%}
  </div>

</section>

<script>
  (function() {
    function initCatalog() {
      const catalog = document.getElementById('shop-catalog');
      if (!catalog) return;

      const isArabic = catalog.getAttribute('data-lang') === 'ar';
      const cards = catalog.querySelectorAll('.product-card');
      const categoryBtns = catalog.querySelectorAll('.category-filter-btn');
      const emptyState = catalog.querySelector('.catalog-empty-state');
      const countText = catalog.querySelector('.catalog-count');
      const titleText = catalog.querySelector('.catalog-title');
      const titleBase = titleText ? titleText.getAttribute('data-title-base') : '';
      const resetBtn = catalog.querySelector('.catalog-reset-btn');

      let activeCategory = 'all';
      let activeSubcategory = 'all';

      const getSubcategoryBtns = () => catalog.querySelectorAll('.subcategory-filter-btn');

      const updateSubcategoryPillsUI = (activeKey) => {
        getSubcategoryBtns().forEach(b => {
          const isSelected = b.getAttribute('data-subcategory') === activeKey;
          if (isSelected) {
            b.className = "subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-[#1a1a1a] text-white border-[#1a1a1a]";
          } else {
            b.className = "subcategory-filter-btn px-5 py-2 rounded-full text-[11px] font-mono-street tracking-[0.15em] whitespace-nowrap border transition bg-white text-zinc-400 hover:text-[#1a1a1a] border-zinc-200";
          }
        });
      };

      const filterGrid = () => {
        let visibleCount = 0;
        
        cards.forEach(card => {
          const cat = (card.getAttribute('data-category') || 'unisex').toLowerCase();
          const sub = (card.getAttribute('data-subcategory') || 'all').toLowerCase();
          const collections = (card.getAttribute('data-collections') || '').toLowerCase();
          const tags = (card.getAttribute('data-tags') || '').toLowerCase();
          const isOnSale = card.getAttribute('data-on-sale') === 'true';
          
          let matchesCategory = false;
          if (activeCategory === 'all') {
            matchesCategory = true;
          } else if (activeCategory === 'new-drops') {
            matchesCategory = collections.includes('new-drops') || 
                              collections.includes('new_drops') || 
                              collections.includes('newdrops') || 
                              tags.includes('new-drops') || 
                              tags.includes('newdrops') || 
                              tags.includes('new drops') ||
                              tags.includes('جديد');
          } else if (activeCategory === 'men') {
            matchesCategory = (cat === 'men' || cat === 'unisex');
          } else if (activeCategory === 'women') {
            matchesCategory = (cat === 'women' || cat === 'unisex');
          } else if (activeCategory === 'sale') {
            matchesCategory = (isOnSale || collections.includes('sale') || collections.includes('archival-sale') || tags.includes('sale') || tags.includes('تخفيضات'));
          }

          let matchesSubcategory = false;
          if (activeSubcategory === 'all') {
            matchesSubcategory = true;
          } else if (activeSubcategory === 'summer') {
            matchesSubcategory = (sub === 'summer' || sub === 'shirt' || sub === 't-shirt');
          } else {
            matchesSubcategory = (sub === activeSubcategory);
          }

          if (matchesCategory && matchesSubcategory) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (countText) {
          if (isArabic) {
            countText.innerHTML = `عرض <span class="count-num">${visibleCount}</span> قطعة مميزة`;
          } else {
            countText.innerHTML = `Showing <span class="count-num">${visibleCount}</span> premium pieces`;
          }
        }

        if (titleText) {
          if (activeCategory === 'men') {
            titleText.textContent = isArabic ? "تشكيلة الرجال" : "Men's Archive";
          } else if (activeCategory === 'women') {
            titleText.textContent = isArabic ? "تشكيلة النساء" : "Women's Archive";
          } else if (activeCategory === 'sale') {
            titleText.textContent = isArabic ? "التخفيضات" : "Archival Sale";
          } else if (activeCategory === 'new-drops') {
            titleText.textContent = isArabic ? "وصل حديثاً" : "New Drops";
          } else {
            titleText.textContent = titleBase;
          }
        }

        if (emptyState) {
          if (visibleCount === 0 && cards.length > 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      };

      categoryBtns.forEach(btn => {
        btn.onclick = function(e) {
          e.preventDefault();
          categoryBtns.forEach(b => {
            b.classList.remove('text-[#1a1a1a]', 'font-bold', 'border-b', 'border-[#1a1a1a]');
            b.classList.add('text-zinc-400');
          });
          btn.classList.add('text-[#1a1a1a]', 'font-bold', 'border-b', 'border-[#1a1a1a]');
          btn.classList.remove('text-zinc-400');

          activeCategory = btn.getAttribute('data-category');
          activeSubcategory = 'all';
          updateSubcategoryPillsUI('all');
          filterGrid();
        };
      });

      getSubcategoryBtns().forEach(btn => {
        btn.onclick = function(e) {
          e.preventDefault();
          activeSubcategory = btn.getAttribute('data-subcategory');
          updateSubcategoryPillsUI(activeSubcategory);
          filterGrid();
        };
      });

      if (resetBtn) {
        resetBtn.onclick = function(e) {
          e.preventDefault();
          const defaultCategoryBtn = catalog.querySelector('.category-filter-btn[data-category="all"]');
          const defaultSubcategoryBtn = catalog.querySelector('.subcategory-filter-btn[data-subcategory="all"]');
          if (defaultCategoryBtn) defaultCategoryBtn.click();
          if (defaultSubcategoryBtn) defaultSubcategoryBtn.click();
        };
      }

      // Initial execution
      filterGrid();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCatalog);
    } else {
      initCatalog();
    }
  })();
</script>

