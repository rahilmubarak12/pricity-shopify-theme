{% comment %}
  Product Card Snippet - Pure Fixed Attributes
{% endcomment %}

{%- liquid
  assign stable_id = product.id
  assign first_variant = product.selected_or_first_available_variant
  assign is_out_of_stock = true
  if product.available
    assign is_out_of_stock = false
  endif

  assign is_on_sale = false
  assign money_off = 0
  if first_variant.compare_at_price > first_variant.price
    assign is_on_sale = true
    assign money_off = first_variant.compare_at_price | minus: first_variant.price
  endif

  # تصنيف دائم يعتمد على رابط المنتج الثابت
  assign h = product.handle | downcase
  assign t = product.tags | join: ' ' | downcase
  
  # تحديد القسم الفرعي
  assign subcat = 't-shirt'
  if h contains 'hoodie' or t contains 'hoodie'
    assign subcat = 'hoodie'
  elsif h contains 'sweatshirt' or h contains 'turtleneck' or t contains 'sweatshirt'
    assign subcat = 'sweatshirt'
  elsif h contains 'set' or h contains 'linen' or h contains 'shirt' or t contains 'set'
    assign subcat = 'shirt'
  elsif h contains 't-shirt' or h contains 'tshirt' or h contains 'tee' or t contains 't-shirt'
    assign subcat = 't-shirt'
  else
    assign subcat = 'summer'
  endif

  # تحديد القسم الرئيسي (رجال / نساء)
  assign cat = 'unisex'
  if t contains 'women' or h contains 'women' or h contains 'cropped'
    assign cat = 'women'
  elsif t contains 'men' or h contains 'men'
    assign cat = 'men'
  endif
-%}

<div 
  class="product-card group flex flex-col cursor-pointer relative" 
  data-category="{{ cat }}" 
  data-subcategory="{{ subcat }}" 
  data-handle="{{ h }}"
  data-on-sale="{{ is_on_sale }}"
  data-oos="{% if is_out_of_stock %}true{% else %}false{% endif %}"
  data-id="{{ stable_id }}"
  data-url="{{ product.url }}"
>
  <!-- Image Container -->
  <div class="relative h-[220px] sm:h-[380px] w-full bg-[#f3f2f0] overflow-hidden mb-3 sm:mb-4">
    {%- if is_out_of_stock -%}
      <span class="absolute top-3 right-3 bg-red-600 text-white text-[9px] sm:text-[10px] font-mono-street font-extrabold uppercase tracking-widest px-2.5 py-1 z-20 rounded-sm">
        {% if request.locale.iso_code == 'ar' %}نفدت الكمية{% else %}Out of Stock{% endif %}
      </span>
    {%- endif -%}

    {%- if is_on_sale and money_off > 0 -%}
      <span class="absolute top-3 left-3 bg-[#1a1a1a] text-white text-[9px] sm:text-[10px] font-mono-street font-extrabold uppercase tracking-widest px-2.5 py-1 z-20 rounded-sm shadow-md">
        {{ money_off | money_without_trailing_zeros }} {% if request.locale.iso_code == 'ar' %}خصم{% else %}OFF{% endif %}
      </span>
    {%- endif -%}

    {%- if product.featured_image != blank -%}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.title | escape }}"
        width="600"
        height="800"
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 group-hover:opacity-0"
      >
    {%- endif -%}

    {%- if product.images[1] != blank -%}
      <img
        src="{{ product.images[1] | image_url: width: 600 }}"
        alt="{{ product.title | escape }}"
        width="600"
        height="800"
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-all duration-500"
      >
    {%- endif -%}
  </div>

  <!-- Details -->
  <div class="flex flex-col gap-1">
    <span class="text-[9px] sm:text-[10px] font-mono-street text-zinc-400 uppercase tracking-[0.2em]">
      {{ product.type | default: 'Collection' }}
    </span>

    <div class="flex items-center justify-between gap-2">
      <h3 class="font-heading font-semibold text-[14px] sm:text-[15px] text-[#1a1a1a] leading-snug flex-1 min-w-0 truncate">
        {{ product.title }}
      </h3>
    </div>

    <div class="flex items-center justify-between mt-1 pt-2 border-t border-zinc-100">
      <span class="font-mono-street font-semibold text-[12px] tracking-wide text-zinc-900">
        {{ product.price | money_without_trailing_zeros }}
      </span>
      {%- if is_on_sale -%}
        <span class="font-mono-street text-[11px] tracking-wide text-zinc-400 line-through">
          {{ first_variant.compare_at_price | money_without_trailing_zeros }}
        </span>
      {%- endif -%}
    </div>
  </div>
</div>