{% comment %}
  Product Detail Snippet
  Shared code for both main-product.liquid section and templates/product.quickview.liquid.
  Accepts:
  - product: {Product} Shopify product object
  - is_modal: {Boolean} true if rendered inside the quickview modal
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign images = product.images
  assign featured_image = current_variant.featured_image | default: product.featured_image

  assign is_out_of_stock = true
  if product.available
    assign is_out_of_stock = false
  endif

  # Calculate discounts
  assign is_on_sale = false
  assign compare_at_price = current_variant.compare_at_price
  assign price = current_variant.price
  if compare_at_price > price
    assign is_on_sale = true
  endif

  # Select size chart based on product title + type keywords
  assign product_title_lower = product.title | downcase
  assign product_type_lower = product.type | downcase
  assign product_tags_string = product.tags | join: ' ' | downcase
  assign combined_text = product_title_lower | append: ' ' | append: product_type_lower | append: ' ' | append: product_tags_string | append: ' ' | append: product.handle
  
  if request.locale.iso_code == 'ar'
    assign size_chart_title = 'دليل المقاسات'
  else
    assign size_chart_title = 'Size Chart'
  endif
  assign size_chart_key = 'default'

  if combined_text contains 'yellow' or combined_text contains 'pink top'
    assign size_chart_key = 'none'
  elsif combined_text contains 'a new era' and combined_text contains 'crop'
    assign size_chart_key = 'a-new-era-cropped'
    if request.locale.iso_code == 'ar'
      assign size_chart_title = 'جدول مقاسات سويت شيرت كروب A New Era'
    else
      assign size_chart_title = 'A New Era Cropped Sweatshirt Size Chart'
    endif
  elsif combined_text contains 'turtleneck'
    assign size_chart_key = 'turtleneck'
    if request.locale.iso_code == 'ar'
      assign size_chart_title = 'جدول مقاسات سويت شيرت هاي كول أوفر سايز'
    else
      assign size_chart_title = 'Oversized Sweatshirt Turtleneck Size Chart'
    endif
  elsif combined_text contains 'double collar' and combined_text contains 'crop'
    assign size_chart_key = 'women-cropped'
    if request.locale.iso_code == 'ar'
      assign size_chart_title = 'جدول مقاسات سويت شيرت دبل كولار نسائي'
    else
      assign size_chart_title = 'Double Collar Cropped Sweatshirt Size Chart'
    endif
  elsif combined_text contains 'hoodie'
    assign size_chart_key = 'hoodie'
    if request.locale.iso_code == 'ar'
      assign size_chart_title = 'جدول مقاسات الهوديز للجنسين'
    else
      assign size_chart_title = 'Unisex Hoodies Size Chart'
    endif
  elsif combined_text contains 'staple' or combined_text contains 'sand'
    assign size_chart_key = 'staple'
    if request.locale.iso_code == 'ar'
      assign size_chart_title = 'جدول مقاسات Staple Sand للجنسين'
    else
      assign size_chart_title = 'Staple Sand Unisex Size Chart'
    endif
  elsif combined_text contains 'linen'
    assign size_chart_key = 'linen'
    if request.locale.iso_code == 'ar'
      assign size_chart_title = 'جدول مقاسات طقم الكتان'
    else
      assign size_chart_title = 'Linen Shirt & Shorts Size Chart'
    endif
  elsif combined_text contains 't-shirt' or combined_text contains 'tshirt' or combined_text contains 't shirt' or combined_text contains 'tee' or combined_text contains 'top'
    assign size_chart_key = 'tshirt'
    if request.locale.iso_code == 'ar'
      assign size_chart_title = 'جدول مقاسات التيشيرتات للجنسين'
    else
      assign size_chart_title = 'Unisex T-Shirt Size Chart'
    endif
  elsif combined_text contains 'set'
    assign size_chart_key = 'linen'
    if request.locale.iso_code == 'ar'
      assign size_chart_title = 'جدول مقاسات طقم الكتان'
    else
      assign size_chart_title = 'Linen Shirt & Shorts Size Chart'
    endif
  elsif combined_text contains 'crop'
    assign size_chart_key = 'women-cropped'
    if request.locale.iso_code == 'ar'
      assign size_chart_title = 'جدول مقاسات سويت شيرت دبل كولار نسائي'
    else
      assign size_chart_title = 'Double Collar Cropped Sweatshirt Size Chart'
    endif
  elsif combined_text contains 'sweatshirt' or combined_text contains 'sweater'
    assign size_chart_key = 'sweatshirt'
    if request.locale.iso_code == 'ar'
      assign size_chart_title = 'جدول مقاسات السويت شيرت للجنسين'
    else
      assign size_chart_title = 'Unisex Sweatshirts Size Chart'
    endif
  else
    assign size_chart_key = 'sweatshirt'
    if request.locale.iso_code == 'ar'
      assign size_chart_title = 'جدول مقاسات السويت شيرت للجنسين'
    else
      assign size_chart_title = 'Unisex Sweatshirts Size Chart'
    endif
  endif

  if product.handle == 'apricity-blush' or product.handle == 'blush-pink-womens-top' or product.handle == 'apy-butter-set' or combined_text contains 'yellow' or combined_text contains 'pink' or combined_text contains 'blush' or product.handle contains 'yellow' or product.handle contains 'pink' or product.handle contains 'blush'
    assign size_chart_key = 'none'
  endif
-%}

{% capture size_chart_html %}
  {% case size_chart_key %}
    {% when 'turtleneck' %}
      <table width="100%"><tbody><tr><td></td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الطول{% else %}Length{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكم{% else %}Sleeve{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}1/2 الصدر{% else %}1/2 Chest{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}1/2 الحاشية{% else %}1/2 Bottom{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكتف{% else %}Shoulder{% endif %}</td></tr><tr style="text-align:center"><td>S/M</td><td>69</td><td>58</td><td>66</td><td>46</td><td>67</td></tr><tr style="text-align:center"><td>M/L</td><td>71</td><td>59</td><td>68</td><td>49</td><td>69</td></tr><tr style="text-align:center"><td>L/XL</td><td>73</td><td>60</td><td>71</td><td>51</td><td>71</td></tr></tbody></table>
    {% when 'women-cropped' %}
      <table width="100%"><tbody><tr><td></td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الطول{% else %}Length{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكم{% else %}Sleeve{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}1/2 الصدر{% else %}1/2 Chest{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}1/2 الحاشية{% else %}1/2 Bottom{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكتف{% else %}Shoulder{% endif %}</td></tr><tr style="text-align:center"><td>XS/S</td><td>43</td><td>52</td><td>46</td><td>37</td><td>55</td></tr><tr style="text-align:center"><td>S/M</td><td>45</td><td>53</td><td>48.5</td><td>39.5</td><td>57</td></tr><tr style="text-align:center"><td>M/L</td><td>47</td><td>54</td><td>51</td><td>42</td><td>59</td></tr></tbody></table>
    {% when 'a-new-era-cropped' %}
      <table width="100%"><tbody><tr><td></td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الطول{% else %}Length{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكم{% else %}Sleeve{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}1/2 الصدر{% else %}1/2 Chest{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}1/2 الحاشية{% else %}1/2 Bottom{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكتف{% else %}Shoulder{% endif %}</td></tr><tr style="text-align:center"><td>XS/S</td><td>44</td><td>59</td><td>52</td><td>43</td><td>59</td></tr><tr style="text-align:center"><td>S/M</td><td>46</td><td>60</td><td>53</td><td>44</td><td>60</td></tr><tr style="text-align:center"><td>M/L</td><td>48</td><td>61</td><td>54</td><td>45</td><td>62</td></tr></tbody></table>
    {% when 'hoodie' %}
      <table width="100%"><tbody><tr><td></td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الطول{% else %}Length{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكم{% else %}Sleeve{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}1/2 الصدر{% else %}1/2 Chest{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}1/2 الحاشية{% else %}1/2 Bottom{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكتف{% else %}Shoulder{% endif %}</td></tr><tr style="text-align:center"><td>S/M</td><td>69</td><td>54-56</td><td>62-63</td><td>54-58</td><td>65-67</td></tr><tr style="text-align:center"><td>M/L</td><td>71</td><td>57-58</td><td>64-66</td><td>56-60</td><td>68-69</td></tr><tr style="text-align:center"><td>L/XL</td><td>73</td><td>59</td><td>67-69</td><td>59-64</td><td>70-74</td></tr></tbody></table>
    {% when 'tshirt' %}
      <table width="100%"><tbody><tr><td></td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الطول{% else %}Length{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكم{% else %}Sleeve{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الصدر{% else %}Chest{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكتف{% else %}Shoulder{% endif %}</td></tr><tr style="text-align:center"><td>S/M</td><td>70</td><td>23</td><td>55</td><td>48</td></tr><tr style="text-align:center"><td>M/L</td><td>75</td><td>25.5</td><td>60</td><td>50</td></tr><tr style="text-align:center"><td>L/XL</td><td>78</td><td>26.5</td><td>62</td><td>53</td></tr></tbody></table>
    {% when 'linen' %}
      <table width="100%"><tbody><tr><td></td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الخصر (مطاط){% else %}Waist (elastic){% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}طول الشورت{% else %}Shorts Length{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}طول القميص{% else %}Shirt Length{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الصدر{% else %}Chest{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكتف{% else %}Shoulder{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}طول الكم{% else %}Sleeve Length{% endif %}</td></tr><tr style="text-align:center"><td>S/M</td><td>33</td><td>43</td><td>64</td><td>51</td><td>46</td><td>23</td></tr><tr style="text-align:center"><td>M/L</td><td>37</td><td>48</td><td>67</td><td>54</td><td>48</td><td>27</td></tr><tr style="text-align:center"><td>L/XL</td><td>43</td><td>50</td><td>70</td><td>57</td><td>50</td><td>30</td></tr></tbody></table>
    {% when 'staple' %}
      <table width="100%"><tbody><tr><td></td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الطول{% else %}Length{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكم{% else %}Sleeve{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الصدر{% else %}Chest{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكتف{% else %}Shoulder{% endif %}</td></tr><tr style="text-align:center"><td>S/M</td><td>68</td><td>26.5</td><td>57</td><td>57</td></tr><tr style="text-align:center"><td>M/L</td><td>74</td><td>28</td><td>62</td><td>59</td></tr><tr style="text-align:center"><td>L/XL</td><td>76</td><td>29</td><td>66.5</td><td>62</td></tr></tbody></table>
    {% when 'none' %}
    {% else %}
      <table width="100%"><tbody><tr><td></td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الطول{% else %}Length{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكم{% else %}Sleeve{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}1/2 الصدر{% else %}1/2 Chest{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}1/2 الحاشية{% else %}1/2 Bottom{% endif %}</td><td style="text-align:center">{% if request.locale.iso_code == 'ar' %}الكتف{% else %}Shoulder{% endif %}</td></tr><tr style="text-align:center"><td>S/M</td><td>69-70</td><td>54</td><td>66-67</td><td>58-59</td><td>68</td></tr><tr style="text-align:center"><td>M/L</td><td>71-72</td><td>55-56</td><td>68-69</td><td>60-61</td><td>69-70</td></tr><tr style="text-align:center"><td>L/XL</td><td>73</td><td>57</td><td>70</td><td>62</td><td>71</td></tr></tbody></table>
  {% endcase %}
{% endcapture %}
{%- assign size_chart_html = size_chart_html | strip -%}

{%- if size_chart_key == 'none' -%}
  {%- assign size_chart_html = '' -%}
{%- endif -%}

{%- assign size_chart_object = product.metafields.custom.size_chart_ref.value -%}
{%- if size_chart_object -%}
  {%- assign default_sc_title = 'Size Chart' -%}
  {%- if request.locale.iso_code == 'ar' -%}{%- assign default_sc_title = 'دليل المقاسات' -%}{%- endif -%}
  {%- assign size_chart_title = size_chart_object.title.value | default: size_chart_object.title | default: default_sc_title -%}

  {%- assign sc_columns_raw = size_chart_object.column_headers.value | default: size_chart_object.column_headers -%}
  {%- if sc_columns_raw.first -%}
    {%- assign sc_columns_str = sc_columns_raw | join: '|||' -%}
  {%- else -%}
    {%- assign sc_columns_str = sc_columns_raw -%}
  {%- endif -%}
  {%- if sc_columns_str != blank -%}
    {%- assign sc_columns_clean = sc_columns_str | newline_to_br | strip_newlines | replace: '<br />', '|||' | replace: '<br>', '|||' -%}
    {%- assign sc_columns = sc_columns_clean | split: '|||' -%}
  {%- else -%}
    {%- assign sc_columns = '' | split: ',' -%}
  {%- endif -%}

  {%- assign sc_rows_raw = size_chart_object.rows.value | default: size_chart_object.rows -%}
  {%- if sc_rows_raw.first -%}
    {%- assign sc_rows_str = sc_rows_raw | join: '|||' -%}
  {%- else -%}
    {%- assign sc_rows_str = sc_rows_raw -%}
  {%- endif -%}
  {%- if sc_rows_str != blank -%}
    {%- assign sc_rows_clean = sc_rows_str | newline_to_br | strip_newlines | replace: '<br />', '|||' | replace: '<br>', '|||' -%}
    {%- assign sc_rows = sc_rows_clean | split: '|||' -%}
  {%- else -%}
    {%- assign sc_rows = '' | split: ',' -%}
  {%- endif -%}

  {%- if sc_columns.size > 0 or sc_rows.size > 0 -%}
    {%- capture size_chart_html -%}
      <table width="100%" style="width:100%;border-collapse:collapse;font-size:0.8125rem;line-height:1.4;table-layout:auto;"><tbody>
        <tr style="background-color:#f5f4f2;"><td style="border:1px solid #e4e4e7;padding:8px 10px;text-align:center;font-weight:600;color:#3f3f46;"></td>
          {%- for col in sc_columns -%}
            {%- assign col_stripped = col | strip -%}
            {%- if col_stripped != blank -%}
              <td style="border:1px solid #e4e4e7;padding:8px 10px;text-align:center;font-weight:600;color:#3f3f46;">{{ col_stripped }}</td>
            {%- endif -%}
          {%- endfor -%}
        </tr>
        {%- for row in sc_rows -%}
          {%- assign row_stripped = row | strip -%}
          {%- if row_stripped != blank -%}
            {%- assign row_parts = row_stripped | split: ',' -%}
            <tr>
              {%- for part in row_parts -%}
                <td style="border:1px solid #e4e4e7;padding:8px 10px;text-align:center;{% if forloop.first %}font-weight:600;color:#3f3f46;{% endif %}">{{ part | strip }}</td>
              {%- endfor -%}
            </tr>
          {%- endif -%}
        {%- endfor -%}
      </tbody></table>
    {%- endcapture -%}
    {%- assign size_chart_html = size_chart_html | strip -%}
  {%- endif -%}
{%- elsif product.metafields.custom.size_chart != blank -%}
  {%- assign size_chart_html = product.metafields.custom.size_chart.value -%}
  {%- if size_chart_title == blank or size_chart_title == 'Size Chart' -%}
    {%- if request.locale.iso_code == 'ar' -%}
      {%- assign size_chart_title = 'دليل المقاسات' -%}
    {%- else -%}
      {%- assign size_chart_title = 'Size Chart' -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

<div class="product-detail-wrapper flex flex-col lg:flex-row w-full h-full" data-product-handle="{{ product.handle }}" data-lang="{{ request.locale.iso_code }}">
  
  <!-- LEFT COLUMN: Image Gallery -->
  <div class="product-detail-gallery w-full lg:w-1/2 bg-zinc-50 p-6 flex flex-col gap-3 lg:h-full lg:overflow-y-auto" style="-webkit-overflow-scrolling: touch;">
    <div class="w-full bg-white rounded-2xl overflow-hidden relative">
      <img 
        src="{{ featured_image | image_url: width: 1000 }}" 
        alt="{{ product.title | escape }}" 
        class="product-main-image w-full h-auto object-contain transition-transform duration-700 ease-out hover:scale-110 cursor-zoom-in" 
        width="1000" height="1000" />
    </div>
    {%- if images.size > 1 -%}
      <div class="flex gap-2 overflow-x-auto pb-1 product-thumbnails">
        {%- for img in images -%}
          <button
            type="button"
            class="thumbnail-btn flex-shrink-0 w-16 h-16 rounded-xl overflow-hidden border-2 transition {% if featured_image == img %}border-black{% else %}border-transparent{% endif %}"
            data-image-url="{{ img | image_url: width: 1000 }}"
          >
            <img src="{{ img | image_url: width: 150 }}" alt="" class="w-full h-full object-cover" width="150" height="150" />
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <!-- RIGHT COLUMN: Details & Option Pickers -->
  <div class="product-detail-info w-full lg:w-1/2 flex flex-col lg:h-full lg:overflow-hidden bg-white">
    <!-- Scrollable Panel -->
    <div class="product-detail-scrollable flex-1 lg:overflow-y-auto px-8 py-10 gap-6 flex flex-col" style="-webkit-overflow-scrolling: touch;">
      
      <!-- Title & Price -->
      <div class="flex flex-col gap-2">
        <h2 class="text-2xl font-bold uppercase leading-tight tracking-tight text-[#1a1a1a]">
          {{ product.title }}
        </h2>
        <div class="flex items-baseline gap-3">
          <span class="product-price-display text-2xl font-semibold tracking-tight text-zinc-900">
            {{ price | money_without_trailing_zeros }}
          </span>
          <span class="product-compare-display text-sm text-zinc-400 line-through {% unless is_on_sale %}hidden{% endunless %}">
            {{ compare_at_price | money_without_trailing_zeros }}
          </span>
        </div>
      </div>

      <!-- Option Selectors -->
      {%- unless product.has_only_default_variant -%}
        <div class="product-options-picker space-y-6">
          {%- for option in product.options_with_values -%}
            {%- assign option_name_lower = option.name | downcase -%}
            
            {%- if option_name_lower == 'color' or option_name_lower == 'colour' -%}
              {%- assign color_option_index = forloop.index0 -%}
              <!-- Color Selector -->
              <div class="option-color-container" data-option-index="{{ color_option_index }}">
                <p class="text-[10px] uppercase tracking-[0.2em] text-zinc-400 mb-3 font-medium">
                  {% if request.locale.iso_code == 'ar' %}اللون —{% else %}Colour —{% endif %} <span class="active-color-label text-zinc-600 normal-case tracking-normal">{{ option.selected_value }}</span>
                </p>
                <div class="flex flex-wrap gap-2">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign color_in_stock = false
                      for variant in product.variants
                        if variant.options[color_option_index] == value and variant.available
                          assign color_in_stock = true
                        endif
                      endfor
                    -%}
                    <button
                      type="button"
                      class="color-option-btn px-4 py-2 text-xs rounded-full border transition-all duration-200 tracking-wide {% if option.selected_value == value %}bg-zinc-900 text-white border-zinc-900 shadow-md{% else %}bg-white text-zinc-700 border-zinc-200 hover:border-zinc-500{% endif %} {% unless color_in_stock %}opacity-35 line-through{% endunless %}"
                      data-value="{{ value }}"
                    >
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>

            {%- elsif option_name_lower == 'size' or option_name_lower == 'sizes' or option_name_lower contains 'size' -%}
              {%- assign size_option_index = forloop.index0 -%}
              <!-- Size Selector -->
              <div class="option-size-container rounded-2xl border border-zinc-100 bg-zinc-50/80 p-5" data-option-index="{{ size_option_index }}">
                <div class="flex items-center justify-between mb-4">
                  <span class="text-[10px] uppercase tracking-[0.2em] text-zinc-400 font-medium">
                    {% if request.locale.iso_code == 'ar' %}اختر المقاس{% else %}Select Size{% endif %}
                  </span>
                  
                  <!-- Live Stock Message -->
                  <span class="stock-status-indicator text-[10px] font-semibold tracking-wide uppercase flex items-center gap-1.5 text-emerald-600">
                    {% if request.locale.iso_code == 'ar' %}متوفر بالمخزون{% else %}In Stock{% endif %}
                  </span>
                </div>

                <div class="grid grid-cols-4 gap-2">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign size_variant = nil
                      for variant in product.variants
                        if variant.options[size_option_index] == value
                          assign size_variant = variant
                        endif
                      endfor
                      assign size_in_stock = false
                      if size_variant != nil and size_variant.available
                        assign size_in_stock = true
                      endif
                      assign qty = size_variant.inventory_quantity
                      assign is_low_stock = false
                      if qty > 0 and qty <= 10
                        assign is_low_stock = true
                      endif
                    -%}
                    <button
                      type="button"
                      {% unless size_in_stock %}disabled{% endunless %}
