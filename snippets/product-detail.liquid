            type="button"
            class="product-qty-btn-minus w-8 h-8 flex items-center justify-center text-zinc-400 hover:text-zinc-950 disabled:opacity-30 transition-colors rounded-full hover:bg-zinc-50"
            aria-label="Decrease quantity"
            disabled
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" x2="19" y1="12" y2="12"></line>
            </svg>
          </button>
          
          <span class="product-qty-display-value font-mono-street text-sm text-zinc-950 font-bold min-w-[1.5rem] text-center">1</span>
          
          <button
            type="button"
            class="product-qty-btn-plus w-8 h-8 flex items-center justify-center text-zinc-400 hover:text-zinc-950 disabled:opacity-30 transition-colors rounded-full hover:bg-zinc-50"
            aria-label="Increase quantity"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" x2="12" y1="5" y2="19"></line>
              <line x1="5" x2="19" y1="12" y2="12"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Buy buttons -->
      <div class="flex gap-2.5">
        <button
          type="button"
          class="product-add-to-cart flex-1 py-4 rounded-xl text-sm font-semibold tracking-[0.1em] uppercase flex items-center justify-center gap-2.5 transition-all duration-300 text-white shadow-lg shadow-zinc-200 disabled:opacity-60 disabled:cursor-not-allowed disabled:text-white" style="background-color: #000000 !important;"
          data-variant-id="{{ current_variant.id }}"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span class="btn-text">
            {%- if is_out_of_stock -%}
              {% if request.locale.iso_code == 'ar' %}نفدت الكمية{% else %}Sold Out{% endif %}
            {%- else -%}
              {% if request.locale.iso_code == 'ar' %}أضف إلى السلة{% else %}Add to Cart{% endif %}
            {%- endif -%}
          </span>
        </button>

        <button
          type="button"
          class="product-quick-buy flex-1 py-4 rounded-xl text-sm font-semibold tracking-[0.1em] uppercase flex items-center justify-center gap-2.5 transition-all duration-300 bg-white text-zinc-900 border border-zinc-300 hover:border-zinc-900 hover:bg-zinc-50 shadow-sm"
          data-variant-id="{{ current_variant.id }}"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {% if request.locale.iso_code == 'ar' %}اشترِ الآن{% else %}Quick Buy{% endif %}
        </button>
      </div>

      {%- if trust_badges_enabled != false -%}
      <!-- Trust Badges -->
      <div class="flex items-center justify-center gap-4 pt-1 pb-1">
        <div class="flex flex-col items-center gap-1 text-zinc-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="text-[9px] uppercase tracking-wider font-medium">{{ trust_badge_1 | default: "Secure Pay" }}</span>
        </div>
        <div class="w-px h-8 bg-zinc-100"></div>
        <div class="flex flex-col items-center gap-1 text-zinc-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span class="text-[9px] uppercase tracking-wider font-medium">{{ trust_badge_2 | default: "Free Delivery" }}</span>
        </div>
        <div class="w-px h-8 bg-zinc-100"></div>
        <div class="flex flex-col items-center gap-1 text-zinc-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          <span class="text-[9px] uppercase tracking-wider font-medium">{{ trust_badge_3 | default: "Easy Returns" }}</span>
        </div>
        <div class="w-px h-8 bg-zinc-100"></div>
        <div class="flex flex-col items-center gap-1 text-zinc-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span class="text-[9px] uppercase tracking-wider font-medium">{{ trust_badge_4 | default: "Premium" }}</span>
        </div>
      </div>
      {%- endif -%}
    </div>

  </div>
</div>

{%- unless is_modal -%}
{%- if sticky_atc_enabled != false -%}
<!-- Sticky Add to Cart Bar -->
<style>
  body.sticky-atc-active .chat-toggle,
  body.sticky-atc-active #shopify-chat,
  body.sticky-atc-active [data-spec="toggle-button"] {
    display: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>
<div id="StickyATC" class="fixed bottom-0 left-0 right-0 z-[9999] translate-y-full transition-transform duration-300 ease-in-out" style="background:#fff; border-top:1px solid #e5e7eb; box-shadow:0 -4px 24px rgba(0,0,0,0.08);">
  <div class="flex items-center gap-3 px-4 py-3">
    <div class="flex-1 min-w-0">
      <p class="text-xs font-semibold text-zinc-900 uppercase tracking-wide truncate sticky-atc-title">{{ product.title }}</p>
      <p class="text-xs text-zinc-500 font-mono-street sticky-atc-price">{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</p>
    </div>
    <button
      type="button"
      id="StickyATCBtn"
      class="shrink-0 px-6 py-3 text-white text-xs font-bold uppercase tracking-widest rounded-xl transition-all disabled:opacity-50"
      style="background-color: #000000 !important;"
    >
      {% if request.locale.iso_code == 'ar' %}أضف إلى السلة{% else %}Add to Cart{% endif %}
    </button>
  </div>
</div>
{%- endif -%}
{%- endunless -%}

  <!-- Size Chart Sub-Modal -->
  {%- if size_chart_html != blank -%}
    <div
      class="product-size-chart-modal hidden fixed inset-0 z-[99999] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm"
    >
      <div
        class="bg-white w-full max-w-2xl rounded-2xl p-6 md:p-8 shadow-2xl flex flex-col relative max-h-[85vh] overflow-hidden"
      >
        <!-- Header -->
        <div class="flex items-center justify-between pb-4 border-b border-zinc-100 mb-6">
          <div class="flex items-center gap-2.5 text-zinc-900 font-semibold tracking-wide uppercase">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" x2="12" y1="5" y2="19"></line>
              <line x1="5" x2="19" y1="12" y2="12"></line>
              <line x1="8" x2="16" y1="16" y2="16"></line>
              <line x1="8" x2="16" y1="8" y2="8"></line>
            </svg>
            <h3 class="text-sm font-semibold text-zinc-900 tracking-wide uppercase">
              {{ size_chart_title }}
            </h3>
          </div>
          <button
            type="button"
            class="size-chart-modal-close p-1.5 rounded-full text-zinc-400 hover:text-zinc-600 hover:bg-zinc-100 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" x2="6" y1="6" y2="18"></line>
              <line x1="6" x2="18" y1="6" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Chart content -->
        <div class="overflow-x-auto overflow-y-auto pr-2 flex-grow">
          <div class="size-chart-table text-sm text-zinc-600">
            {{ size_chart_html }}
          </div>
        </div>

        <!-- Footer -->
        <div class="mt-6 pt-4 border-t border-zinc-100 text-[10px] text-zinc-400 flex items-center justify-center">
          <span>{% if request.locale.iso_code == 'ar' %}جميع القياسات بالسنتيمتر (سم) ما لم يُذكر خلاف ذلك.{% else %}All measurements are in centimeters (cm) unless specified otherwise.{% endif %}</span>
        </div>
      </div>
    </div>
  {%- endif -%}

  <!-- Product JSON for Variant Checking Script -->
  <script type="application/json" class="product-raw-json">
    {
      "id": "{{ product.id }}",
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": "{{ variant.id }}",
            "title": "{{ variant.title | escape }}",
            "options": {{ variant.options | json }},
            "available": {{ variant.available | json }},
            "inventory_quantity": {{ variant.inventory_quantity | default: 99 }},
            "price": "{{ variant.price | money_without_trailing_zeros }}",
            "price_raw": {{ variant.price }},
            "compare_at_price": "{{ variant.compare_at_price | money_without_trailing_zeros }}",
            "featured_image": {% if variant.featured_image != blank %}"{{ variant.featured_image | image_url: width: 1000 }}"{% else %}null{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "options": {{ product.options | json }}
    }
  </script>

  <script>
  (function() {
    function setupProductDetail() {
      const container = document.querySelector('.product-detail-wrapper');
      if (!container) return;

      const isAr = container.getAttribute('data-lang') === 'ar';
      const rawJsonEl = container.querySelector('.product-raw-json');
      let productData = null;
      try {
        if (rawJsonEl) productData = JSON.parse(rawJsonEl.textContent);
      } catch (e) {
        console.error('Failed to parse product JSON', e);
      }

      let selectedOptions = [];
      if (productData && productData.options) {
        productData.options.forEach((opt, idx) => {
          const activeColor = container.querySelector('.option-color-container[data-option-index="' + idx + '"] .color-option-btn.bg-zinc-900');
          const activeSize = container.querySelector('.option-size-container[data-option-index="' + idx + '"] .size-option-btn.bg-zinc-900');
          if (activeColor) selectedOptions[idx] = activeColor.getAttribute('data-value');
          else if (activeSize) selectedOptions[idx] = activeSize.getAttribute('data-value');
          else selectedOptions[idx] = opt.values ? opt.values[0] : '';
        });
      }

      const mainImg = container.querySelector('.product-main-image');
      const thumbBtns = container.querySelectorAll('.thumbnail-btn');
      const priceDisplay = container.querySelector('.product-price-display');
      const compareDisplay = container.querySelector('.product-compare-display');
      const atcBtn = container.querySelector('.product-add-to-cart');
      const atcText = atcBtn ? atcBtn.querySelector('.btn-text') : null;
      const quickBuyBtn = container.querySelector('.product-quick-buy');
      const stockIndicator = container.querySelector('.stock-status-indicator');
      const qtyMinus = container.querySelector('.product-qty-btn-minus');
      const qtyPlus = container.querySelector('.product-qty-btn-plus');
      const qtyVal = container.querySelector('.product-qty-display-value');

      let currentQty = 1;
      let currentVariant = productData && productData.variants ? productData.variants[0] : null;

      // 1. Thumbnails
      thumbBtns.forEach(btn => {
        btn.onclick = function(e) {
          e.preventDefault();
          const targetSrc = btn.getAttribute('data-image-url');
          if (mainImg && targetSrc) mainImg.src = targetSrc;
          thumbBtns.forEach(b => {
            b.classList.remove('border-black');
            b.classList.add('border-transparent');
          });
          btn.classList.add('border-black');
          btn.classList.remove('border-transparent');
        };
      });

      // 2. Quantity
      if (qtyMinus && qtyPlus && qtyVal) {
        qtyMinus.onclick = function(e) {
          e.preventDefault();
          if (currentQty > 1) {
            currentQty--;
            qtyVal.textContent = currentQty;
            if (currentQty === 1) qtyMinus.disabled = true;
          }
        };
        qtyPlus.onclick = function(e) {
          e.preventDefault();
          currentQty++;
          qtyVal.textContent = currentQty;
          qtyMinus.disabled = false;
        };
      }

      // 3. Variant Matcher
      function updateVariant() {
        if (!productData || !productData.variants) return;

        currentVariant = productData.variants.find(v => {
          return v.options.every((val, idx) => selectedOptions[idx] === val);
        }) || productData.variants[0];

        if (!currentVariant) return;

        if (atcBtn) atcBtn.setAttribute('data-variant-id', currentVariant.id);
        if (quickBuyBtn) quickBuyBtn.setAttribute('data-variant-id', currentVariant.id);

        if (priceDisplay) priceDisplay.textContent = currentVariant.price;
        if (compareDisplay) {
          if (currentVariant.compare_at_price && currentVariant.compare_at_price !== '' && currentVariant.compare_at_price !== currentVariant.price) {
            compareDisplay.textContent = currentVariant.compare_at_price;
            compareDisplay.classList.remove('hidden');
          } else {
            compareDisplay.classList.add('hidden');
          }
        }

        if (mainImg && currentVariant.featured_image) {
          mainImg.src = currentVariant.featured_image;
        }

        if (atcBtn && atcText) {
          if (currentVariant.available) {
            atcBtn.disabled = false;
            if (quickBuyBtn) quickBuyBtn.disabled = false;
            atcText.textContent = isAr ? 'أضف إلى السلة' : 'Add to Cart';
            if (stockIndicator) {
              stockIndicator.className = 'stock-status-indicator text-[10px] font-semibold tracking-wide uppercase flex items-center gap-1.5 text-emerald-600';
              stockIndicator.textContent = isAr ? 'متوفر بالمخزون' : 'In Stock';
            }
          } else {
            atcBtn.disabled = true;
            if (quickBuyBtn) quickBuyBtn.disabled = true;
            atcText.textContent = isAr ? 'نفدت الكمية' : 'Sold Out';
            if (stockIndicator) {
              stockIndicator.className = 'stock-status-indicator text-[10px] font-semibold tracking-wide uppercase flex items-center gap-1.5 text-zinc-400';
              stockIndicator.textContent = isAr ? 'نفدت الكمية' : 'Sold Out';
            }
          }
        }
      }

      // 4. Color Clicks
      container.querySelectorAll('.option-color-container').forEach(colorWrap => {
        const optIndex = parseInt(colorWrap.getAttribute('data-option-index'), 10);
        const label = colorWrap.querySelector('.active-color-label');
        colorWrap.querySelectorAll('.color-option-btn').forEach(btn => {
          btn.onclick = function(e) {
            e.preventDefault();
            const val = btn.getAttribute('data-value');
            selectedOptions[optIndex] = val;
            if (label) label.textContent = val;

            colorWrap.querySelectorAll('.color-option-btn').forEach(b => {
              b.classList.remove('bg-zinc-900', 'text-white', 'border-zinc-900', 'shadow-md');
              b.classList.add('bg-white', 'text-zinc-700', 'border-zinc-200');
            });
            btn.classList.remove('bg-white', 'text-zinc-700', 'border-zinc-200');
            btn.classList.add('bg-zinc-900', 'text-white', 'border-zinc-900', 'shadow-md');

            updateVariant();
          };
        });
      });

      // 5. Size Clicks
      container.querySelectorAll('.option-size-container').forEach(sizeWrap => {
        const optIndex = parseInt(sizeWrap.getAttribute('data-option-index'), 10);
        sizeWrap.querySelectorAll('.size-option-btn').forEach(btn => {
          btn.onclick = function(e) {
            e.preventDefault();
            if (btn.disabled) return;
            const val = btn.getAttribute('data-value');
            selectedOptions[optIndex] = val;

            sizeWrap.querySelectorAll('.size-option-btn').forEach(b => {
              if (!b.disabled) {
                b.classList.remove('bg-zinc-900', 'text-white', 'border-zinc-900', 'shadow-lg', 'scale-[1.03]');
                b.classList.add('bg-white', 'text-zinc-800', 'border-zinc-200');
              }
            });
            btn.classList.remove('bg-white', 'text-zinc-800', 'border-zinc-200');
            btn.classList.add('bg-zinc-900', 'text-white', 'border-zinc-900', 'shadow-lg', 'scale-[1.03]');

            updateVariant();
          };
        });
      });

      // 6. Accordions
      container.querySelectorAll('.accordion-header').forEach(header => {
        header.onclick = function(e) {
          e.preventDefault();
          const item = header.closest('.accordion-item');
          const body = item ? item.querySelector('.accordion-body') : null;
          const plus = header.querySelector('.accordion-plus');
          if (!body) return;
          const isHidden = body.classList.contains('hidden');
          if (isHidden) {
            body.classList.remove('hidden');
            if (plus) plus.textContent = '−';
          } else {
            body.classList.add('hidden');
            if (plus) plus.textContent = '+';
          }
        };
      });

      // 7. Size Guide
      const guideBtn = container.querySelector('.size-guide-trigger-btn');
      const sizeModal = container.querySelector('.product-size-chart-modal');
      const modalClose = container.querySelector('.size-chart-modal-close');
      if (guideBtn && sizeModal) {
        guideBtn.onclick = function(e) { e.preventDefault(); sizeModal.classList.remove('hidden'); };
        if (modalClose) modalClose.onclick = function() { sizeModal.classList.add('hidden'); };
        sizeModal.onclick = function(e) { if (e.target === sizeModal) sizeModal.classList.add('hidden'); };
      }

      // 8. Add to Cart & Quick Buy Requests
      function performAddToCart(isCheckout) {
        const targetVariantId = atcBtn ? atcBtn.getAttribute('data-variant-id') : null;
        if (!targetVariantId) return;

        const originalText = atcText ? atcText.textContent : '';
        if (atcBtn) atcBtn.disabled = true;
        if (atcText) atcText.textContent = '...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: parseInt(targetVariantId, 10), quantity: currentQty })
        })
        .then(res => {
          if (!res.ok) throw new Error('Add to cart failed');
          return res.json();
        })
        .then(item => {
          if (isCheckout) {
            window.location.href = '/checkout';
            return;
          }
          if (atcText) atcText.textContent = '✓';
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { item: item, openDrawer: true } }));
          setTimeout(() => {
            if (atcBtn) atcBtn.disabled = false;
            if (atcText) atcText.textContent = originalText;
          }, 1200);
        })
        .catch(err => {
          console.error(err);
          if (atcBtn) atcBtn.disabled = false;
          if (atcText) atcText.textContent = isAr ? 'خطأ' : 'Error';
          setTimeout(() => { if (atcText) atcText.textContent = originalText; }, 1500);
        });
      }

      if (atcBtn) atcBtn.onclick = function(e) { e.preventDefault(); performAddToCart(false); };
      if (quickBuyBtn) quickBuyBtn.onclick = function(e) { e.preventDefault(); performAddToCart(true); };

      // 9. Sticky ATC Bar
      const stickyBar = document.getElementById('StickyATC');
      const stickyBtn = document.getElementById('StickyATCBtn');
      if (stickyBar && atcBtn) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              stickyBar.classList.add('translate-y-full');
              document.body.classList.remove('sticky-atc-active');
            } else {
              stickyBar.classList.remove('translate-y-full');
              document.body.classList.add('sticky-atc-active');
            }
          });
        }, { threshold: 0.1 });
        observer.observe(atcBtn);
        if (stickyBtn) stickyBtn.onclick = function() { atcBtn.click(); };
      }

      updateVariant();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupProductDetail);
    } else {
      setupProductDetail();
    }
  })();
  </script>
</div>